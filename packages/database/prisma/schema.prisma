// ── HR-5: Payroll / Finance FOUNDATION (TEST / SYNTHETIC — no execution) ─────────────────────
// Payroll CONSUMES approved/locked worked time (ApprovedWorkedTime) and turns it into a governed
// calculation snapshot. It never recomputes attendance and never moves money. There is deliberately
// NO `paid` state and no banking/remittance model here. Jurisdiction is modelled explicitly by
// country + region (province/state); a rule provider + version is recorded on every snapshot so a
// calculation is reproducible and never silently re-based. Money is stored as integer minor units
// with an explicit currency (see @rwos/shared Money) — no floating-point columns.

// Governed pay-period lifecycle. No `paid` — execution is a separately-approved future gate.
enum PayrollPeriodStatus {
  open
  calculating
  review
  approved
  locked
}

// A calculation snapshot's own lifecycle. Recalculation supersedes a prior revision; an approved
// revision is never overwritten.
enum PayrollCalculationStatus {
  calculated
  in_review
  approved
  rejected
  superseded
  locked
}

// Deduction lines are classified generically. Real statutory remittance logic is NOT implemented
// in HR-5 — categories are governed data the rule provider populates.
enum PayrollDeductionCategory {
  statutory
  benefit
  voluntary
  garnishment
  other
}

model PayrollPeriod {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  jurisdictionCountry String             @map("jurisdiction_country")
  jurisdictionRegion String              @map("jurisdiction_region")
