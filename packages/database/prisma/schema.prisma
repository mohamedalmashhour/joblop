// A multi-role staffing order: one employer submission that groups several job requests (one per
// role line, e.g. 2 chefs + 1 aid + 3 dishwashers), sharing a worksite and time window. Each child
// job request keeps its own governed pricing snapshot, admin approval, dispatch and payroll; the
// order is the grouping + a single submit/cancel + a combined view. Shared-context columns
// (residence/department/creator) are app-validated against the org (children hold the enforced FKs);
// only organization_id and the job_requests.order_id link carry DB foreign keys.
model EmployerOrder {
  id              String              @id @default(uuid()) @db.Uuid
  orderNumber     String              @unique @map("order_number")
  organizationId  String              @map("organization_id") @db.Uuid
  residenceId     String              @map("residence_id") @db.Uuid
  departmentId    String              @map("department_id") @db.Uuid
  creatorUserId   String              @map("creator_user_id") @db.Uuid
  title           String
  note            String?
  perks           String?
  requestType     JobRequestType      @map("request_type")
  urgency         JobRequestUrgency   @default(normal)
  timezone        String
  startAt         DateTime            @map("start_at") @db.Timestamptz(3)
  endAt           DateTime            @map("end_at") @db.Timestamptz(3)
  status          EmployerOrderStatus @default(draft)
  version         Int                 @default(1)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  updatedByUserId String?             @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt     DateTime?           @map("submitted_at") @db.Timestamptz(3)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(3)

  organization EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRequests  JobRequest[]

  @@index([organizationId, status, createdAt], map: "employer_orders_org_status_created_idx")
  @@index([organizationId, residenceId, status], map: "employer_orders_org_residence_status_idx")
  @@map("employer_orders")
}

