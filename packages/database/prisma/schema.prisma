model SyntheticDeliveryAttempt {
  id                      String   @id @default(uuid()) @db.Uuid
  idempotencyId           String   @map("idempotency_id") @db.Uuid
  attemptNumber           Int      @map("attempt_number")
  eligibleAt              DateTime @map("eligible_at") @db.Timestamptz(3)
  executedAt              DateTime @map("executed_at") @db.Timestamptz(3)
  simulationScenario      String   @map("simulation_scenario") @db.VarChar(64)
  responseStatus          String   @map("response_status") @db.VarChar(32)
  retryable               Boolean
  providerReferenceDigest String?  @map("provider_reference_digest") @db.Char(64)
  resultCategory          String   @map("result_category") @db.VarChar(64)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  idempotency SyntheticDeliveryIdempotency @relation(fields: [idempotencyId], references: [id], onDelete: Restrict)

  @@unique([idempotencyId, attemptNumber], map: "synthetic_delivery_attempts_record_number_key")
  @@map("synthetic_delivery_attempts")
}

// Stage 2b.4-C3-F4 (G-a): durable cross-instance lease for the aged-processing reconciliation sweeper.
// A single logical lease row per lock name is claimed atomically (INSERT ... ON CONFLICT). The
// fencingToken increments on every acquisition so a stalled prior owner can never release or write
// after ownership changed. This lease is DEFENSE-IN-DEPTH only: per-payment correctness remains the
// existing optimistic version/state guard inside reconcile(); the lease never moves money.
model PaymentSweepLease {
  name         String    @id
  owner        String?
  fencingToken BigInt    @default(0) @map("fencing_token")
  acquiredAt   DateTime? @map("acquired_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_sweep_lease")
}

// Stage 2b.4-C3-F4 (G-a): durable, fail-closed kill switch for the sweeper. Default OFF (enabled =
// false); a MISSING row is also treated as OFF. Changeable without an application deployment (operator
// updates this row). Checked before candidate selection / reconciliation.
model PaymentSweepControl {
  name      String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_sweep_control")
}

// JobScanner: EXTERNAL job postings aggregated from legal partner feeds (Adzuna now; Talent.com etc.
// later). These are leads we display and hand off to the source — NOT JobLop governed jobs; no JobLop
// pay/classification/dispatch applies and no money ever moves through them. Upserted by (source,
// sourceId) on each scan; firstSeenAt/lastSeenAt track freshness for the scheduled re-scan.
model ExternalJobLead {
  id             String    @id @default(uuid()) @db.Uuid
  source         String
  sourceId       String    @map("source_id")
  title          String
  employer       String?
  locationLabel  String?   @map("location_label")
  city           String?
  province       String?
  latitude       Float?
  longitude      Float?
  salaryMinMinor Int?      @map("salary_min_minor")
  salaryMaxMinor Int?      @map("salary_max_minor")
  salaryPeriod   String?   @map("salary_period")
  contractTime   String?   @map("contract_time")
  category       String?
  url            String
  postedAt       DateTime? @map("posted_at") @db.Timestamptz(3)
  description    String?
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@unique([source, sourceId], map: "external_job_leads_source_sourceid_key")
  @@index([province, city], map: "external_job_leads_province_city_idx")
  @@map("external_job_leads")
}

// JobScanner CV builder: a worker's own CV attachments — certificates (MAPAQ, RCR, cariste, licence)
// and an optional photo. The worker owns these; they are referenced on the CV (certificates listed in
// a Certifications section). Bytes stored inline (small files; validated type + size). Not the
// governance-heavy HR compliance document store (that is worker_identity / org-scoped).
model CvAsset {
  id          String   @id @default(uuid()) @db.Uuid
  workerRef   String   @map("worker_ref") // worker identity id, or a wizard session ref pre-signup
  kind        String // "certificate" | "photo"
  label       String?
  filename    String
  contentType String   @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workerRef], map: "cv_assets_worker_ref_idx")
  @@map("cv_assets")
}

// Worker Pro paid plan: entitlement that unlocks (1) AI-written CVs + premium designs and (2) PRIORITY
// job access — best / higher-wage leads and emergency requests surfaced first. Free tier browses jobs
// and gets a basic synthetic draft (funnel intact). Enforcement is SERVER-SIDE only (no client trust).
// Real payment collection is FROZEN — entitlements are granted by an admin (real admin mechanism) or,
// later, by a gated purchase once payments + the finance gate open. Append-only; active = 'active' and
// not expired.
model CvEntitlement {
  id              String    @id @default(uuid()) @db.Uuid
  workerRef       String    @map("worker_ref")
  plan            String // "cv_pro"
  status          String // "active" | "revoked" | "expired"
  source          String // "admin_grant" | "trial" | "purchase"
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workerRef, status], map: "cv_entitlements_worker_status_idx")
  @@map("cv_entitlements")
}

// Worker Pro purchase orders. A worker "subscribes" → a PENDING order is recorded with the displayed
// price. The charge itself is GATED OFF (CV_PRO_PURCHASE_ENABLED, default disabled) and no real money
// moves — Stripe/live payments stay frozen platform-wide. When the gate opens (payments + finance
// cleared), completing an order marks it paid and grants the entitlement (source "purchase"). Until
// then subscribe only records intent; nothing is charged.
model CvProOrder {
  id           String    @id @default(uuid()) @db.Uuid
  workerRef    String    @map("worker_ref")
  plan         String
  priceMinor   Int       @map("price_minor")
  currency     String
  periodMonths Int       @map("period_months")
  method       String    @default("e_transfer") // "e_transfer" | "stripe"
  status       String // "pending_payment" | "payment_claimed" | "paid" | "canceled"
  paymentRef   String?   @map("payment_ref")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(3)

  @@index([workerRef, status], map: "cv_pro_orders_worker_status_idx")
  @@map("cv_pro_orders")
}
