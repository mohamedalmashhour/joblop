  @@map("qa_reset_manifest_tenants")
}

model QaResetOwnedRecord {
  id                String                   @id @default(uuid()) @db.Uuid
  manifestId        String                   @map("manifest_id") @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  namespace         String                   @db.VarChar(96)
  entityType        String                   @map("entity_type") @db.VarChar(48)
  manifestRecordKey String                   @map("manifest_record_key") @db.VarChar(160)
  targetRecordId    String                   @map("target_record_id") @db.Uuid
  lifecycleStatus   QaResetOwnedRecordStatus @default(declared) @map("lifecycle_status")
  preparedAt        DateTime?                @map("prepared_at") @db.Timestamptz(3)
  verifiedAt        DateTime?                @map("verified_at") @db.Timestamptz(3)
  cleanedAt         DateTime?                @map("cleaned_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  manifest QaResetManifestOwnership @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  tenant   QaResetManifestTenant    @relation(fields: [manifestId, tenantId], references: [manifestId, tenantId], onDelete: Restrict)

  @@unique([manifestId, entityType, targetRecordId], map: "qa_reset_owned_records_manifest_entity_target_key")
  @@unique([manifestId, manifestRecordKey], map: "qa_reset_owned_records_manifest_record_key")
  @@index([namespace, tenantId, entityType], map: "qa_reset_owned_records_scope_idx")
  @@map("qa_reset_owned_records")
}

model QaResetControlRun {
  id                    String           @id @default(uuid()) @db.Uuid
  manifestId            String           @map("manifest_id") @db.Uuid
  operation             QaResetOperation
  scope                 QaResetScope
  idempotencyDigest     String           @unique @map("idempotency_digest") @db.Char(64)
  planChecksum          String           @map("plan_checksum") @db.Char(64)
  preparationReceipt    String?          @map("preparation_receipt") @db.Char(64)
  resultReceipt         String?          @map("result_receipt") @db.Char(64)
  callerAlias           String           @map("caller_alias") @db.VarChar(64)
  callerPrincipalDigest String           @map("caller_principal_digest") @db.Char(64)
  approvalReference     String           @map("approval_reference") @db.VarChar(160)
  correlationId         String           @map("correlation_id") @db.VarChar(96)
  status                QaResetRunStatus @default(planned)
  failureCategory       String?          @map("failure_category") @db.VarChar(64)
  expectedRecordCount   Int              @map("expected_record_count")
  observedRecordCount   Int?             @map("observed_record_count")
  startedAt             DateTime?        @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz(3)
  retentionUntil        DateTime         @map("retention_until") @db.Timestamptz(3)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  manifest QaResetManifestOwnership @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  events   QaResetControlEvent[]

  @@index([status, retentionUntil], map: "qa_reset_control_runs_status_retention_idx")
  @@map("qa_reset_control_runs")
}

model QaResetControlEvent {
  id                    String            @id @default(uuid()) @db.Uuid
  controlRunId          String            @map("control_run_id") @db.Uuid
  sequence              Int
  eventType             String            @map("event_type") @db.VarChar(64)
  priorStatus           QaResetRunStatus? @map("prior_status")
  newStatus             QaResetRunStatus  @map("new_status")
  callerAlias           String            @map("caller_alias") @db.VarChar(64)
  callerPrincipalDigest String            @map("caller_principal_digest") @db.Char(64)
  safeCount             Int?              @map("safe_count")
  reasonCategory        String?           @map("reason_category") @db.VarChar(64)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  controlRun QaResetControlRun @relation(fields: [controlRunId], references: [id], onDelete: Restrict)

  @@unique([controlRunId, sequence], map: "qa_reset_control_events_run_sequence_key")
  @@index([createdAt], map: "qa_reset_control_events_created_idx")
  @@map("qa_reset_control_events")
}

model SyntheticDeliveryIdempotency {
  id                      String                  @id @default(uuid()) @db.Uuid
  environment             String                  @db.VarChar(16)
  contractVersion         String                  @map("contract_version") @db.VarChar(32)
  releaseSha              String                  @map("release_sha") @db.Char(40)
  manifestChecksum        String                  @map("manifest_checksum") @db.Char(64)
  tenantId                String                  @map("tenant_id") @db.Uuid
  callerAlias             String                  @map("caller_alias") @db.VarChar(64)
  operation               String                  @db.VarChar(64)
  idempotencyKeyDigest    String                  @map("idempotency_key_digest") @db.Char(64)
  requestDigest           String                  @map("request_digest") @db.Char(64)
  workerOfferId           String                  @map("worker_offer_id") @db.Uuid
  termsVersionId          String                  @map("terms_version_id") @db.Uuid
  workerIdentityId        String                  @map("worker_identity_id") @db.Uuid
  status                  SyntheticDeliveryStatus @default(claimed)
  providerReferenceDigest String?                 @map("provider_reference_digest") @db.Char(64)
  retryable               Boolean                 @default(false)
  attemptCount            Int                     @default(0) @map("attempt_count")
  nextAttemptAt           DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  failureCategory         String?                 @map("failure_category") @db.VarChar(64)
  terminalAt              DateTime?               @map("terminal_at") @db.Timestamptz(3)
  retentionUntil          DateTime                @map("retention_until") @db.Timestamptz(3)
  version                 Int                     @default(1)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts SyntheticDeliveryAttempt[]

  @@unique([environment, contractVersion, releaseSha, manifestChecksum, tenantId, callerAlias, operation, idempotencyKeyDigest], map: "synthetic_delivery_idempotency_scope_key")
  @@index([status, retentionUntil], map: "synthetic_delivery_idempotency_status_retention_idx")
  @@index([tenantId, workerOfferId], map: "synthetic_delivery_idempotency_tenant_offer_idx")
  @@map("synthetic_delivery_idempotency")
