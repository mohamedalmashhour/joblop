# Environment classification:
# - EXPO_PUBLIC_* / NEXT_PUBLIC_* entries explicitly approved by the bundle policy are build-time
#   public. NODE_ENV is build-time public.
# - Identifiers, release/configuration flags and PORT are server-only non-secret.
# - Origins, URLs and audiences without a public prefix are runtime server-only.
# - Tokens, credentials, passwords, database/Redis URLs, HMAC keys, service accounts, operator
#   identities and test-account emails are prohibited from public bundles and logs.
# - SESSION_SECRET is reserved/unconsumed and is not a current runtime requirement.
NODE_ENV=development
RWOS_ENV=local
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resident_workforce_os
# SESSION_SECRET=reserved-unconsumed-do-not-configure
API_PORT=4100
INTERNAL_API_ORIGIN=http://127.0.0.1:4100
# Production only: shared atomic authentication limiter service.
# AUTH_RATE_LIMITER_ORIGIN=https://rate-limit.example.invalid
# AUTH_RATE_LIMITER_TOKEN=replace-with-at-least-32-random-characters
# AUTH_RATE_LIMITER_KEY_SECRET=replace-with-a-distinct-32-character-secret
# AUTH_RATE_LIMITER_KEY_ID=approved-key-identifier
# AUTH_RATE_LIMITER_NAMESPACE=rwos:authrl:staging:v1
# AUTH_LIMITER_AUTH_MODE=dual-required
# AUTH_LIMITER_AUDIENCE=https://immutable-cloud-run-service-url.run.app
# AUTH_LIMITER_API_SERVICE_ACCOUNT=immutable-api-service-identity
# Auth-limiter service runtime; secret values are supplied by the approved secret manager.
# AUTH_LIMITER_REDIS_URL=rediss://approved-staging-redis-endpoint
# AUTH_LIMITER_SERVICE_TOKEN=set-in-secret-manager
# AUTH_LIMITER_RELEASE_SHA=approved-immutable-release-sha
# AUTH_LIMITER_NAMESPACE=rwos:authrl:staging:v1
# AUTH_LIMITER_CURRENT_KEY_ID=approved-current-key-id
# AUTH_LIMITER_PREVIOUS_KEY_ID=approved-previous-key-id
# AUTH_LIMITER_PREVIOUS_KEY_ACCEPT_UNTIL=approved-rfc3339-expiration
# Staging reset only; all five values are required together when explicitly authorized.
# AUTH_LIMITER_RESET_ENABLED=false
# AUTH_LIMITER_RESET_TOKEN=set-in-secret-manager
# AUTH_LIMITER_PROJECT_ID=immutable-staging-project-id
# AUTH_LIMITER_CLUSTER_ID=immutable-staging-redis-id
# PASSWORD_RESET_PUBLIC_ORIGIN=https://employer-staging.example.invalid
# EMPLOYER_SELF_REGISTRATION_ENABLED=disabled
# TERMS_VERSION=approved-version-reference
# PRIVACY_NOTICE_VERSION=approved-version-reference
# Optional production integrations; both origin and token are required when enabled.
# CANDIDATE_SOURCE_ORIGIN=https://candidate-source.example.invalid
# CANDIDATE_SOURCE_TOKEN=replace-with-at-least-32-random-characters
# Candidate-source staging adapter service; values are supplied outside source control.
# CANDIDATE_ADAPTER_RELEASE_SHA=approved-immutable-release-sha
# CANDIDATE_ADAPTER_SERVICE_TOKEN=set-in-secret-manager
# CANDIDATE_ADAPTER_AUTH_MODE=dual-required
# CANDIDATE_ADAPTER_AUDIENCE=https://immutable-cloud-run-service-url.run.app
# CANDIDATE_ADAPTER_API_SERVICE_ACCOUNT=immutable-api-service-identity
# CANDIDATE_ADAPTER_TENANT_A_ID=immutable-synthetic-tenant-uuid
# CANDIDATE_ADAPTER_TENANT_A_WORK_GROUP_ID=immutable-synthetic-work-group-uuid
# CANDIDATE_ADAPTER_TENANT_A_ROLE_DEFINITION_ID=immutable-synthetic-role-definition-uuid
# CANDIDATE_ADAPTER_TENANT_B_ID=immutable-synthetic-tenant-uuid
# CANDIDATE_ADAPTER_TENANT_B_WORK_GROUP_ID=immutable-synthetic-work-group-uuid
# CANDIDATE_ADAPTER_TENANT_B_ROLE_DEFINITION_ID=immutable-synthetic-role-definition-uuid
# CANDIDATE_ADAPTER_ALLOWED_TIMEZONES=America/Toronto
# CANDIDATE_ADAPTER_TENANT_LIMIT_PER_MINUTE=30
# CANDIDATE_ADAPTER_SERVICE_LIMIT_PER_MINUTE=60
# OFFER_DELIVERY_ORIGIN=https://offer-delivery.example.invalid
# OFFER_DELIVERY_TOKEN=replace-with-at-least-32-random-characters
# Offer-delivery synthetic staging adapter; values are supplied outside source control.
# OFFER_DELIVERY_ADAPTER_RELEASE_SHA=approved-immutable-release-sha
# OFFER_DELIVERY_ADAPTER_SERVICE_TOKEN=set-in-secret-manager
# OFFER_DELIVERY_ADAPTER_AUTH_MODE=dual-required
# OFFER_DELIVERY_ADAPTER_AUDIENCE=https://immutable-cloud-run-service-url.run.app
# OFFER_DELIVERY_ADAPTER_API_SERVICE_ACCOUNT=immutable-api-service-identity
# OFFER_DELIVERY_ADAPTER_TENANT_A_ID=immutable-synthetic-tenant-uuid
# OFFER_DELIVERY_ADAPTER_TENANT_B_ID=immutable-synthetic-tenant-uuid
# OFFER_DELIVERY_ADAPTER_TENANT_LIMIT_PER_MINUTE=30
# OFFER_DELIVERY_ADAPTER_SERVICE_LIMIT_PER_MINUTE=60
# QA-reset staging service; identifiers and secret references are supplied outside source control.
# QA_RESET_RELEASE_SHA=approved-immutable-release-sha
# QA_RESET_AUTH_MODE=dual-required
# QA_RESET_AUDIENCE=https://immutable-qa-reset-service.run.app
# QA_RESET_BROWSER_E2E_APP_CREDENTIAL=set-in-secret-manager-runner-only
# QA_RESET_BROWSER_E2E_SERVICE_ACCOUNT=immutable-browser-runner-service-account
# QA_RESET_BROWSER_E2E_OPERATOR_IDENTITY=immutable-browser-operator-id
# QA_RESET_IOS_E2E_APP_CREDENTIAL=set-in-secret-manager-runner-only
# QA_RESET_IOS_E2E_SERVICE_ACCOUNT=immutable-ios-runner-service-account
# QA_RESET_IOS_E2E_OPERATOR_IDENTITY=immutable-ios-operator-id
# QA_RESET_ANDROID_E2E_APP_CREDENTIAL=set-in-secret-manager-runner-only
# QA_RESET_ANDROID_E2E_SERVICE_ACCOUNT=immutable-android-runner-service-account
# QA_RESET_ANDROID_E2E_OPERATOR_IDENTITY=immutable-android-operator-id
# QA_RESET_MANUAL_QA_APP_CREDENTIAL=set-in-secret-manager-server-only
# QA_RESET_MANUAL_QA_SERVICE_ACCOUNT=immutable-manual-qa-service-account
# QA_RESET_MANUAL_QA_OPERATOR_IDENTITY=immutable-manual-qa-operator-id
# QA_RESET_MONITORING_APP_CREDENTIAL=set-in-secret-manager-monitoring-only
# QA_RESET_MONITORING_SERVICE_ACCOUNT=immutable-monitoring-service-account
# QA_RESET_PROJECT_ID=immutable-staging-project-id
# QA_RESET_CLUSTER_ID=immutable-staging-cluster-id
# QA_RESET_DATABASE_ID=immutable-staging-database-id
# QA_RESET_AUTHORITY_ID=immutable-staging-reset-authority-id
# QA_RESET_TENANT_A_ID=immutable-synthetic-tenant-id
# QA_RESET_TENANT_B_ID=immutable-synthetic-tenant-id
# QA_RESET_NAMESPACE=rwos:qa-reset:staging:v1
# QA_RESET_MANIFEST_ID=approved-manifest-id
# QA_RESET_MANIFEST_CHECKSUM=approved-lowercase-sha256
# QA_RESET_MANIFEST_CREATED_AT=approved-rfc3339-time
# QA_RESET_MANIFEST_EXPIRES_AT=approved-rfc3339-time
# QA_RESET_DRY_RUN_APPROVAL_REFERENCE=immutable-approval-reference
# QA_RESET_PREPARE_APPROVAL_REFERENCE=immutable-approval-reference
# QA_RESET_CLEANUP_APPROVAL_REFERENCE=immutable-approval-reference
# QA_RESET_MAXIMUM_RECORDS_PER_ENTITY=2
ASSIGNMENT_HANDOFF_ENABLED=disabled
# Staging-only, one-time first Platform Administrator bootstrap. Secret values are injected by
# approved secret references and are never committed.
# RWOS_ADMIN_BOOTSTRAP_ENABLED=disabled
# RWOS_ADMIN_BOOTSTRAP_SECRET=set-in-secret-manager-job-only
# RWOS_ADMIN_BOOTSTRAP_SECRET_EXPIRES_AT=approved-rfc3339-time
# RWOS_ADMIN_BOOTSTRAP_EMAIL=approved-staging-admin-email
# RWOS_ADMIN_BOOTSTRAP_DISPLAY_NAME=approved-staging-admin-display-name
# RWOS_ADMIN_BOOTSTRAP_INITIAL_PASSWORD=set-in-secret-manager-job-only
# Stripe is disabled by default. Test references are injected into the API only after separate
# owner approval; live keys are rejected.
# STRIPE_TEST_MODE_ENABLED=disabled
# STRIPE_TEST_SECRET_KEY=set-in-secret-manager-api-only
# STRIPE_TEST_WEBHOOK_SECRET=set-in-secret-manager-api-only
# STRIPE_TEST_ACCOUNT_REFERENCE=approved-test-account-reference
# STRIPE_ACSS_DEBIT_ENABLED=disabled
# RWOS_STRIPE_NETWORK_TEST_CONFIRMATION=disabled
