# Copy to deploy/.env and fill in REAL values. deploy/.env is gitignored — never commit it.
# Payments/finance stay FROZEN — do not add production payment keys or FINANCE_LIVE here.

# Postgres (keep the data volume on your SSD, not the USB drive)
POSTGRES_USER=joblop
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=joblop

# The API connects to the postgres service by its compose name "postgres"
DATABASE_URL=postgresql://joblop:change-me-to-a-long-random-string@postgres:5432/joblop

# Country profile (production, not test mode)
RWOS_COUNTRY=canada

# Optional integrations — leave blank to run without them
#  - ANTHROPIC_API_KEY turns on AI-written CVs (Worker Pro). Billed to you by Anthropic.
#  - ADZUNA keys turn on live JobScanner (else mock feed).
ANTHROPIC_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca

# Worker Pro card checkout stays OFF (e-transfer is the active method). Do not enable until payments open.
# CV_PRO_PURCHASE_ENABLED=enabled
