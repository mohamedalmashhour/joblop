generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  email_verification_pending
  active
  restricted
  disabled
  closed
}

enum IdentityProvider {
  local_password
  dev_test
  future_oauth
}

enum MfaState {
  not_configured
  optional
  required
  enrolled
  locked
}

enum SessionStatus {
  active
  expired
  revoked
}

enum EmployerOrganizationStatus {
  invited
  pending_review
  active
  restricted
  suspended
  closed
}

enum OrganizationMembershipStatus {
  invited
  active
  suspended
  revoked
  expired
}

enum ResidenceStatus {
  draft
  active
  restricted
  inactive
  closed
}

enum DepartmentStatus {
  draft
  active
  restricted
  inactive
  closed
}

enum CatalogueStatus {
  active
  inactive
  retired
}

enum AccessRoleStatus {
  draft
  active
  restricted
  retired
}

enum AccessRoleScope {
  platform
  organization
  worker
}

enum JobRequestStatus {
  draft
  submitted
  admin_review
  information_required
  approved_for_dispatch
  cancelled
  expired
  archived
}

enum JobRequestUrgency {
  normal
  urgent
  immediate
}

enum JobRequestType {
  single_day
  multi_day
  recurring_intent
}

enum CalendarVerificationState {
  pending
  verified
  failed
  unavailable
}

enum AuditActorType {
  user
  system
  service
}

enum AuditSource {
  api
  admin
  employer
  worker
  system
}

enum QaResetManifestStatus {
  draft
  approved
  active
  expired
  revoked
  retired
}

enum QaResetOwnedRecordStatus {
  declared
  prepared
  verified
  cleaned
  blocked
}

enum QaResetOperation {
  dry_run
  prepare
  cleanup
}

enum QaResetScope {
  browser
  ios
  android
  manual_qa
}

enum QaResetRunStatus {
  planned
  running
  succeeded
  failed
  unknown
  blocked
  cleanup_completed
}

enum SyntheticDeliveryStatus {
  claimed
  completed
  retry_pending
  failed_terminal
  unknown
  blocked
  expired
}

enum DispatchReviewStatus {
  draft
  active
  candidate_review
  shortlist_ready
  offer_preparation
  paused
  cancelled
  closed
}

enum DispatchType {
  initial
  replacement_reserved
}

enum DispatchPriority {
  normal
  urgent
  emergency
}

enum DispatchCandidateSourceType {
  internal_worker_profile
  invited_worker
  staffing_partner
  enterprise_employee_pool
  external_integration
  imported_record
  unavailable
}

enum DispatchMatchState {
  match
  partial_match
  no_match
  not_evaluated
}

enum DispatchSummaryState {
  meets_requirements
  partially_meets
  missing_required
  verification_pending
  expired
  not_evaluated
}

enum DispatchAvailabilityState {
  available
  partially_available
  unavailable
  not_evaluated
  source_unavailable
}

enum DispatchConflictState {
  conflict_free
  conflict_detected
  not_evaluated
  source_unavailable
}

enum DispatchServiceAreaState {
  inside_service_area
  outside_service_area
  not_evaluated
  source_unavailable
}

enum DispatchTravelState {
  suitable
  unsuitable
  unknown
  not_evaluated
  source_unavailable
}

enum DispatchTransportState {
  available
  unavailable
  unknown
  not_evaluated
  source_unavailable
}

enum DispatchRecommendationState {
  not_evaluated
  recommended
  not_recommended
  alternative
  unavailable
}

enum DispatchShortlistState {
  not_shortlisted
  shortlisted
  removed
}

enum WorkerIdentityStatus {
  active
  inactive
  closed
}

enum WorkerOfferStatus {
  draft
  approved
  sent
  delivered
  viewed
  accepted
  declined
  expired
  withdrawn
  cancelled
}

enum WorkerOfferDeliveryStatus {
  pending
  attempted
  delivered
  failed
}

enum WorkerOfferResponseType {
  accepted
  declined
}

enum AssignmentStatus {
  pending_validation
  confirmed
  worker_acknowledged
  ready_for_attendance
  in_attendance_window
  attendance_handoff
  worker_withdrawn
  employer_cancelled
  platform_cancelled
  replacement_required
  expired_before_start
  closed
}

enum AttendanceStatus {
  pending_start
  checked_in
  checked_out
  completed
  missed
  cancelled
  exception
}

enum TimesheetStatus {
  draft
  calculation_pending
  review_required
  worker_review
  employer_review
  platform_review
  approved
  locked
  rejected
  correction_required
  cancelled
}

enum InvoiceStatus {
  draft
  approved
  issued
  sent
  viewed
  partially_paid
  paid
  overdue
  disputed
  voided
  refunded
}

enum InvoiceIssuerModel {
  platform_principal
  worker_supplier
  self_billing_agent
}

enum InvoiceTaxTreatment {
  taxable
  zero_rated
  exempt
  tax_not_enabled
}

enum EmployerPaymentState {
  pending
  authorized
  processing
  succeeded
  failed
  cancelled
  partially_refunded
  refunded
  disputed
}

enum PaymentPolicyMode {
  invoice_only
  authorize_before_assignment_capture_after_invoice
  collect_after_invoice
  manual_collection
}

enum UploadedDocumentState {
  quarantined
  scan_error
  infected
  clean
  approved
  rejected
  replaced
  expired
  deleted
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  publicId        String     @unique @map("public_id")
  emailNormalized String     @unique @map("email_normalized")
  displayName     String?    @map("display_name")
  status          UserStatus @default(email_verification_pending)
  primaryLanguage String?    @map("primary_language")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt      DateTime?  @map("disabled_at") @db.Timestamptz(3)
  closedAt        DateTime?  @map("closed_at") @db.Timestamptz(3)

  identities                    UserIdentity[]
  sessions                      Session[]
  emailVerificationCodes        EmailVerificationCode[]
  passwordResetTokens           PasswordResetToken[]
  createdOrganizations          EmployerOrganization[]       @relation("EmployerOrganizationCreatedByUser")
  reviewedOrganizations         EmployerOrganization[]       @relation("EmployerOrganizationReviewedByUser")
  memberships                   OrganizationMembership[]     @relation("OrganizationMembershipUser")
  invitedMemberships            OrganizationMembership[]     @relation("OrganizationMembershipInvitedByUser")
  createdResidences             Residence[]                  @relation("ResidenceCreatedByUser")
  createdDepartments            Department[]                 @relation("DepartmentCreatedByUser")
  assignedMembershipAccessRoles MembershipAccessRole[]       @relation("MembershipAccessRoleAssignedByUser")
  createdJobRequests            JobRequest[]                 @relation("JobRequestCreator")
  authoredJobRequests           JobRequest[]                 @relation("JobRequestCreatedByUser")
  updatedJobRequests            JobRequest[]                 @relation("JobRequestUpdatedByUser")
  ownedDispatchReviews          DispatchReview[]             @relation("DispatchReviewOwner")
  createdDispatchReviews        DispatchReview[]             @relation("DispatchReviewCreatedByUser")
  updatedDispatchReviews        DispatchReview[]             @relation("DispatchReviewUpdatedByUser")
  addedDispatchCandidates       DispatchCandidate[]          @relation("DispatchCandidateAddedByUser")
  removedDispatchCandidates     DispatchCandidate[]          @relation("DispatchCandidateRemovedByUser")
  workerIdentity                WorkerIdentity?
  createdWorkerOffers           WorkerOffer[]                @relation("WorkerOfferCreatedByUser")
  updatedWorkerOffers           WorkerOffer[]                @relation("WorkerOfferUpdatedByUser")
  approvedWorkerOffers          WorkerOffer[]                @relation("WorkerOfferApprovedByUser")
  sentWorkerOffers              WorkerOffer[]                @relation("WorkerOfferSentByUser")
  withdrawnWorkerOffers         WorkerOffer[]                @relation("WorkerOfferWithdrawnByUser")
  cancelledWorkerOffers         WorkerOffer[]                @relation("WorkerOfferCancelledByUser")
  createdWorkerOfferTerms       WorkerOfferTermsVersion[]    @relation("WorkerOfferTermsCreatedByUser")
  createdWorkerOfferDeliveries  WorkerOfferDeliveryAttempt[] @relation("WorkerOfferDeliveryCreatedByUser")
  createdAssignments            Assignment[]                 @relation("AssignmentCreatedByUser")
  updatedAssignments            Assignment[]                 @relation("AssignmentUpdatedByUser")
  confirmedAssignments          Assignment[]                 @relation("AssignmentConfirmedByUser")
  cancelledAssignments          Assignment[]                 @relation("AssignmentCancelledByUser")
  createdAttendanceRecords      AttendanceRecord[]           @relation("AttendanceCreatedByUser")
  updatedAttendanceRecords      AttendanceRecord[]           @relation("AttendanceUpdatedByUser")
  checkedInAttendanceRecords    AttendanceRecord[]           @relation("AttendanceCheckedInByUser")
  checkedOutAttendanceRecords   AttendanceRecord[]           @relation("AttendanceCheckedOutByUser")
  cancelledAttendanceRecords    AttendanceRecord[]           @relation("AttendanceCancelledByUser")
  createdTimesheets             Timesheet[]                  @relation("TimesheetCreatedByUser")
  updatedTimesheets             Timesheet[]                  @relation("TimesheetUpdatedByUser")
  workerReviewedTimesheets      Timesheet[]                  @relation("TimesheetWorkerReviewedByUser")
  employerReviewedTimesheets    Timesheet[]                  @relation("TimesheetEmployerReviewedByUser")
  platformReviewedTimesheets    Timesheet[]                  @relation("TimesheetPlatformReviewedByUser")
  lockedTimesheets              Timesheet[]                  @relation("TimesheetLockedByUser")
  auditActorReferences          AuditActorReference[]
  platformAccessGrants          PlatformAccessGrant[]
  completedAdminBootstraps      InitialAdminBootstrap[]      @relation("InitialAdminBootstrapCreatedUser")
  ownedUploadedDocuments        UploadedDocument[]           @relation("UploadedDocumentOwner")

  @@index([emailNormalized], map: "users_email_normalized_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserIdentity {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  provider          IdentityProvider
  providerSubject   String           @map("provider_subject")
  emailVerifiedAt   DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  passwordHash      String?          @map("password_hash")
  passwordUpdatedAt DateTime?        @map("password_updated_at") @db.Timestamptz(3)
  mfaState          MfaState         @default(not_configured) @map("mfa_state")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject], map: "user_identities_provider_subject_key")
  @@index([userId], map: "user_identities_user_id_idx")
  @@index([provider, providerSubject], map: "user_identities_provider_subject_idx")
  @@map("user_identities")
}

model Session {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  sessionHash   String        @unique @map("session_hash")
  status        SessionStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz(3)
  ipHash        String?       @map("ip_hash")
  userAgentHash String?       @map("user_agent_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionHash], map: "sessions_session_hash_idx")
  @@index([userId, status], map: "sessions_user_id_status_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model EmailVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, createdAt], map: "email_verification_codes_user_active_idx")
  @@index([expiresAt], map: "email_verification_codes_expires_at_idx")
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, createdAt], map: "password_reset_tokens_user_active_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model EmployerOrganization {
  id               String                     @id @default(uuid()) @db.Uuid
  publicId         String                     @unique @map("public_id")
  legalName        String                     @map("legal_name")
  displayName      String                     @map("display_name")
  status           EmployerOrganizationStatus @default(pending_review)
  createdByUserId  String?                    @map("created_by_user_id") @db.Uuid
  reviewedByUserId String?                    @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  restrictedAt     DateTime?                  @map("restricted_at") @db.Timestamptz(3)
  suspendedAt      DateTime?                  @map("suspended_at") @db.Timestamptz(3)
  closedAt         DateTime?                  @map("closed_at") @db.Timestamptz(3)

  createdBy            User?                    @relation("EmployerOrganizationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy           User?                    @relation("EmployerOrganizationReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  memberships          OrganizationMembership[]
  residences           Residence[]
  departments          Department[]
  jobRequests          JobRequest[]
  dispatchReviews      DispatchReview[]
  workerOffers         WorkerOffer[]
  assignments          Assignment[]
  attendanceRecords    AttendanceRecord[]
  timesheets           Timesheet[]
  invoices             Invoice[]
  paymentMethods       EmployerPaymentMethod[]
  paymentAttempts      EmployerPaymentAttempt[]
  paymentPolicies      PaymentPolicyVersion[]
  uploadedDocuments    UploadedDocument[]
  auditActorReferences AuditActorReference[]

  @@index([status], map: "employer_organizations_status_idx")
  @@map("employer_organizations")
}

model OrganizationMembership {
  id              String                       @id @default(uuid()) @db.Uuid
  organizationId  String                       @map("organization_id") @db.Uuid
  userId          String                       @map("user_id") @db.Uuid
  status          OrganizationMembershipStatus @default(invited)
  invitedByUserId String?                      @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  acceptedAt      DateTime?                    @map("accepted_at") @db.Timestamptz(3)
  suspendedAt     DateTime?                    @map("suspended_at") @db.Timestamptz(3)
  revokedAt       DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  expiredAt       DateTime?                    @map("expired_at") @db.Timestamptz(3)

  organization    EmployerOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User                   @relation("OrganizationMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy       User?                  @relation("OrganizationMembershipInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  membershipRoles MembershipAccessRole[]

  @@index([organizationId, status], map: "organization_memberships_organization_id_status_idx")
  @@index([userId, status], map: "organization_memberships_user_id_status_idx")
  @@map("organization_memberships")
}

model Residence {
  id              String          @id @default(uuid()) @db.Uuid
  publicId        String          @unique @map("public_id")
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  status          ResidenceStatus @default(draft)
  addressSummary  String?         @map("address_summary")
  city            String?
  region          String?
  country         String?
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)

  organization      EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User?                @relation("ResidenceCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  departments       Department[]
  jobRequests       JobRequest[]
  dispatchReviews   DispatchReview[]
  workerOffers      WorkerOffer[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  timesheets        Timesheet[]

  @@unique([organizationId, id], map: "residences_organization_id_id_key")
  @@index([organizationId, status], map: "residences_organization_id_status_idx")
  @@index([organizationId, name], map: "residences_organization_id_name_idx")
  @@map("residences")
}

model Department {
  id              String           @id @default(uuid()) @db.Uuid
  publicId        String           @unique @map("public_id")
  organizationId  String           @map("organization_id") @db.Uuid
  residenceId     String           @map("residence_id") @db.Uuid
  name            String
  status          DepartmentStatus @default(draft)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(3)

  organization      EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  residence         Residence            @relation(fields: [organizationId, residenceId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User?                @relation("DepartmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  jobRequests       JobRequest[]
  dispatchReviews   DispatchReview[]
  workerOffers      WorkerOffer[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  timesheets        Timesheet[]

  @@unique([organizationId, id], map: "departments_organization_id_id_key")
  @@unique([residenceId, id], map: "departments_residence_id_id_key")
  @@unique([organizationId, residenceId, id], map: "departments_organization_id_residence_id_id_key")
  @@index([organizationId, status], map: "departments_organization_id_status_idx")
  @@index([residenceId, status], map: "departments_residence_id_status_idx")
  @@index([residenceId, name], map: "departments_residence_id_name_idx")
  @@map("departments")
}

model WorkGroup {
  id                       String          @id @default(uuid()) @db.Uuid
  key                      String          @unique
  displayLabel             String          @map("display_label")
  status                   CatalogueStatus @default(active)
  displayOrder             Int             @map("display_order")
  iconKey                  String?         @map("icon_key")
  qualificationSummary     String?         @map("qualification_summary")
  safetyRequirementSummary String?         @map("safety_requirement_summary")
  defaultTemplateKey       String?         @map("default_template_key")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleDefinitions   RoleDefinition[]
  jobRequests       JobRequest[]
  dispatchReviews   DispatchReview[]
  workerOfferTerms  WorkerOfferTermsVersion[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  timesheets        Timesheet[]

  @@index([status, displayOrder], map: "work_groups_status_display_order_idx")
  @@map("work_groups")
}

model RoleDefinition {
  id                       String          @id @default(uuid()) @db.Uuid
  workGroupId              String          @map("work_group_id") @db.Uuid
  key                      String          @unique
  displayLabel             String          @map("display_label")
  status                   CatalogueStatus @default(active)
  displayOrder             Int             @map("display_order")
  localizedLabelKey        String?         @map("localized_label_key")
  qualificationSummary     String?         @map("qualification_summary")
  safetyRequirementSummary String?         @map("safety_requirement_summary")
  adminConfigurable        Boolean         @default(false) @map("admin_configurable")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workGroup         WorkGroup                 @relation(fields: [workGroupId], references: [id], onDelete: Restrict)
  jobRequests       JobRequest[]
  dispatchReviews   DispatchReview[]
  workerOfferTerms  WorkerOfferTermsVersion[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  timesheets        Timesheet[]

  @@unique([workGroupId, id], map: "role_definitions_work_group_id_id_key")
  @@index([workGroupId, status, displayOrder], map: "role_definitions_work_group_id_status_display_order_idx")
  @@map("role_definitions")
}

model AccessRoleDefinition {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  scope       AccessRoleScope
  status      AccessRoleStatus @default(active)
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions     AccessRolePermission[]
  membershipRoles MembershipAccessRole[]
  platformGrants  PlatformAccessGrant[]

  @@map("access_role_definitions")
}

model PlatformAccessGrant {
  userId                 String   @map("user_id") @db.Uuid
  accessRoleDefinitionId String   @map("access_role_definition_id") @db.Uuid
  grantedAt              DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  releaseSha             String   @map("release_sha") @db.Char(40)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessRole AccessRoleDefinition @relation(fields: [accessRoleDefinitionId], references: [id], onDelete: Restrict)

  @@id([userId, accessRoleDefinitionId], map: "platform_access_grants_pkey")
  @@index([accessRoleDefinitionId], map: "platform_access_grants_role_idx")
  @@map("platform_access_grants")
}

model InitialAdminBootstrap {
  key           String    @id @db.VarChar(64)
  secretDigest  String    @map("secret_digest") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdUserId String?   @map("created_user_id") @db.Uuid
  environment   String    @db.VarChar(16)
  releaseSha    String    @map("release_sha") @db.Char(40)
  outcome       String    @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdUser User? @relation("InitialAdminBootstrapCreatedUser", fields: [createdUserId], references: [id], onDelete: Restrict)

  @@index([usedAt], map: "initial_admin_bootstrap_used_at_idx")
  @@map("initial_admin_bootstrap")
}

model PermissionDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  phase       String
  implemented Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accessRoles AccessRolePermission[]

  @@map("permission_definitions")
}

model AccessRolePermission {
  accessRoleDefinitionId String   @map("access_role_definition_id") @db.Uuid
  permissionDefinitionId String   @map("permission_definition_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  accessRole AccessRoleDefinition @relation(fields: [accessRoleDefinitionId], references: [id], onDelete: Restrict)
