{
  "expo": {
    "name": "JobLop",
    "slug": "resident-workforce-os",
    "scheme": "rwos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "bundleIdentifier": "com.joblop.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.joblop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c2654"
      }
    },
    "extra": {
      "foundationOnly": true
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
