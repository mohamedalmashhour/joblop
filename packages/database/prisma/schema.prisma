  @@index([organizationId, departmentId, status], map: "job_requests_organization_id_department_id_status_idx")
  @@index([organizationId, startAt], map: "job_requests_organization_id_start_at_idx")
  @@index([status, submittedAt], map: "job_requests_status_submitted_at_idx")
  @@index([createdByUserId, createdAt], map: "job_requests_created_by_user_id_created_at_idx")
  @@index([orderId, createdAt], map: "job_requests_order_id_created_at_idx")
