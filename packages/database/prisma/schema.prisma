// Worker payout ledger: the money owed to a worker for a locked payroll calculation (net pay, W-based),
// and its release lifecycle. The two-week hold anchors to the pay-period end (the practical stand-in
// for "two weeks after the work" while payroll aggregates per period). Lifecycle: pending -> released
// (hold elapsed, no open dispute) -> paid (external Interac/EFT send confirmed). A dispute moves it to
// held until resolved. The actual money movement is a provider integration wired separately.
enum WorkerPayoutStatus {
  pending
  released
  paid
  held
  cancelled
}

model WorkerPayout {
  id                   String             @id @default(uuid()) @db.Uuid
  workerIdentityId     String             @map("worker_identity_id") @db.Uuid
  payrollCalculationId String             @unique @map("payroll_calculation_id") @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  currency             String
  amountMinor          Int                @map("amount_minor")
  status               WorkerPayoutStatus @default(pending)
  holdUntil            DateTime           @map("hold_until") @db.Timestamptz(3)
  releasedAt           DateTime?          @map("released_at") @db.Timestamptz(3)
  paidAt               DateTime?          @map("paid_at") @db.Timestamptz(3)
  heldReason           String?            @map("held_reason")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  workerIdentity WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)

  @@index([workerIdentityId, status], map: "worker_payouts_worker_status_idx")
  @@index([status, holdUntil], map: "worker_payouts_status_hold_idx")
  @@map("worker_payouts")
}

// Worker dispute: a worker contests what they are owed for a finished shift (its payroll calculation /
// payout). While a dispute is open it PAUSES that payout — the payout moves to `held` and is never
// released until the dispute is resolved or withdrawn. Linked by payroll_calculation_id (1:1 with a
// worker_payouts row). Admin resolution is handled separately.
enum WorkerDisputeStatus {
  open
  resolved
  withdrawn
}

model WorkerDispute {
  id                   String              @id @default(uuid()) @db.Uuid
  workerIdentityId     String              @map("worker_identity_id") @db.Uuid
  payrollCalculationId String              @map("payroll_calculation_id") @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  status               WorkerDisputeStatus @default(open)
  category             String
  reason               String
  resolution           String?
  resolvedAt           DateTime?           @map("resolved_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workerIdentity WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)

  @@index([workerIdentityId, status], map: "worker_disputes_worker_status_idx")
  @@index([payrollCalculationId, status], map: "worker_disputes_calc_status_idx")
  @@map("worker_disputes")
}

// Owner-escalation of a role line: when the AI manager or an admin flags a role as needing the
// platform owners' judgement (an emergency, an unusually large ask, or anything non-standard), an
// open escalation is recorded here for the owner queue. Resolving it is a human decision; the actual
// approval still flows through the governed intake transition. One OPEN escalation per role at a time
// (enforced in the app). Reference/workflow state only — it never prices, pays, or bills.
enum RequestEscalationStatus {
  open
  resolved
  dismissed
}

model RequestEscalation {
  id               String                  @id @default(uuid()) @db.Uuid
  jobRequestId     String                  @map("job_request_id") @db.Uuid
  orderId          String?                 @map("order_id") @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  reason           String
  status           RequestEscalationStatus @default(open)
  raisedByUserId   String                  @map("raised_by_user_id") @db.Uuid
  resolvedByUserId String?                 @map("resolved_by_user_id") @db.Uuid
  resolution       String?
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?               @map("resolved_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "request_escalations_status_created_idx")
  @@index([jobRequestId, status], map: "request_escalations_request_status_idx")
  @@map("request_escalations")
}

// Admin-maintained market-wage reference: an indicative market hourly rate for a role in a province,
// shown to employers beside their own contract rate so they can judge how competitive it is. Reference
// data ONLY — it never feeds pricing, payroll or invoices. One row per (role, province).
model MarketWageReference {
  id                    String    @id @default(uuid()) @db.Uuid
  roleDefinitionId      String    @map("role_definition_id") @db.Uuid
  province              String
  medianHourlyRateMinor Int       @map("median_hourly_rate_minor")
  currency              String
  source                String?
  effectiveFrom         DateTime? @map("effective_from") @db.Timestamptz(3)
  updatedByUserId       String?   @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([roleDefinitionId, province], map: "market_wage_references_role_province_key")
  @@index([province], map: "market_wage_references_province_idx")
  @@map("market_wage_references")
}

// Immutable per-request hidden-markup record, captured when an admin approves a request for dispatch.
// Stores the employer rate (E), the admin-chosen margin, the derived worker rate (W), and the
// per-allowance employer/worker splits. Payroll pays W from here; each audience view reads only its
// own side (worker = W, employer = E); the platform margin is the difference. One snapshot per request.
model RequestPricingSnapshot {
  id                        String   @id @default(uuid()) @db.Uuid
  jobRequestId              String   @unique @map("job_request_id") @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  contractId                String   @map("contract_id") @db.Uuid
  contractVersion           String   @map("contract_version")
  currency                  String
  marginPpm                 Int      @map("margin_ppm")
  employerHourlyRateMinor   Int      @map("employer_hourly_rate_minor")
  workerHourlyRateMinor     Int      @map("worker_hourly_rate_minor")
  platformHourlyMarginMinor Int      @map("platform_hourly_margin_minor")
  transportEmployerMinor    Int      @default(0) @map("transport_employer_minor")
  transportWorkerMinor      Int      @default(0) @map("transport_worker_minor")
  mealEmployerMinor         Int      @default(0) @map("meal_employer_minor")
  mealWorkerMinor           Int      @default(0) @map("meal_worker_minor")
  lodgingEmployerMinor      Int      @default(0) @map("lodging_employer_minor")
  lodgingWorkerMinor        Int      @default(0) @map("lodging_worker_minor")
  capturedByUserId          String   @map("captured_by_user_id") @db.Uuid
  capturedAt                DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, capturedAt], map: "request_pricing_snapshots_org_captured_idx")
  @@index([contractId, contractVersion], map: "request_pricing_snapshots_contract_idx")
  @@map("request_pricing_snapshots")
}

model DispatchReview {
  id                        String               @id @default(uuid()) @db.Uuid
  jobRequestId              String               @map("job_request_id") @db.Uuid
  organizationId            String               @map("organization_id") @db.Uuid
  residenceId               String               @map("residence_id") @db.Uuid
  departmentId              String               @map("department_id") @db.Uuid
  workGroupId               String               @map("work_group_id") @db.Uuid
  roleDefinitionId          String               @map("role_definition_id") @db.Uuid
  dispatchType              DispatchType         @default(initial) @map("dispatch_type")
  state                     DispatchReviewStatus @default(draft)
  operationalOwnerUserId    String?              @map("operational_owner_user_id") @db.Uuid
  priority                  DispatchPriority     @default(normal)
  urgency                   JobRequestUrgency    @default(normal)
  requiredWorkerCount       Int                  @map("required_worker_count")
  shortlistedCandidateCount Int                  @default(0) @map("shortlisted_candidate_count")
  preparedOfferCount        Int                  @default(0) @map("prepared_offer_count")
  startedAt                 DateTime?            @map("started_at") @db.Timestamptz(3)
  pausedAt                  DateTime?            @map("paused_at") @db.Timestamptz(3)
  cancelledAt               DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  closedAt                  DateTime?            @map("closed_at") @db.Timestamptz(3)
  createdByUserId           String               @map("created_by_user_id") @db.Uuid
  updatedByUserId           String?              @map("updated_by_user_id") @db.Uuid
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                   Int                  @default(1)

  jobRequest       JobRequest           @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  organization     EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  residence        Residence            @relation(fields: [organizationId, residenceId], references: [organizationId, id], onDelete: Restrict)
  department       Department           @relation(fields: [organizationId, residenceId, departmentId], references: [organizationId, residenceId, id], onDelete: Restrict)
  workGroup        WorkGroup            @relation(fields: [workGroupId], references: [id], onDelete: Restrict)
  roleDefinition   RoleDefinition       @relation(fields: [workGroupId, roleDefinitionId], references: [workGroupId, id], onDelete: Restrict)
  operationalOwner User?                @relation("DispatchReviewOwner", fields: [operationalOwnerUserId], references: [id], onDelete: SetNull)
  createdBy        User                 @relation("DispatchReviewCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy        User?                @relation("DispatchReviewUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  candidates       DispatchCandidate[]
  workerOffers     WorkerOffer[]
  assignments      Assignment[]

  @@unique([id, jobRequestId, organizationId, residenceId, departmentId], map: "dispatch_reviews_operational_scope_key")
  @@index([jobRequestId], map: "dispatch_reviews_job_request_id_idx")
  @@index([organizationId, state, updatedAt], map: "dispatch_reviews_organization_id_state_updated_at_idx")
  @@index([operationalOwnerUserId, state], map: "dispatch_reviews_operational_owner_user_id_state_idx")
  @@index([residenceId, state], map: "dispatch_reviews_residence_id_state_idx")
  @@index([departmentId, state], map: "dispatch_reviews_department_id_state_idx")
  @@map("dispatch_reviews")
}

model DispatchCandidate {
  id                        String                      @id @default(uuid()) @db.Uuid
  dispatchReviewId          String                      @map("dispatch_review_id") @db.Uuid
  workerIdentityId          String?                     @map("worker_identity_id") @db.Uuid
  candidateSourceType       DispatchCandidateSourceType @map("candidate_source_type")
  candidateSourceReference  String                      @map("candidate_source_reference")
  approvedDisplayName       String                      @map("approved_display_name")
  workGroupMatch            DispatchMatchState          @default(not_evaluated) @map("work_group_match")
  roleDefinitionMatch       DispatchMatchState          @default(not_evaluated) @map("role_definition_match")
  qualificationSummaryState DispatchSummaryState        @default(not_evaluated) @map("qualification_summary_state")
  verificationSummaryState  DispatchSummaryState        @default(not_evaluated) @map("verification_summary_state")
  availabilityState         DispatchAvailabilityState   @default(not_evaluated) @map("availability_state")
  scheduleConflictState     DispatchConflictState       @default(not_evaluated) @map("schedule_conflict_state")
  serviceAreaState          DispatchServiceAreaState    @default(not_evaluated) @map("service_area_state")
  travelSuitabilityState    DispatchTravelState         @default(not_evaluated) @map("travel_suitability_state")
  transportConstraintState  DispatchTransportState      @default(not_evaluated) @map("transport_constraint_state")
  recommendationState       DispatchRecommendationState @default(not_evaluated) @map("recommendation_state")
  shortlistState            DispatchShortlistState      @default(not_shortlisted) @map("shortlist_state")
  shortlistOrder            Int?                        @map("shortlist_order")
  sourceFreshnessAt         DateTime?                   @map("source_freshness_at") @db.Timestamptz(3)
  lastEvaluatedAt           DateTime?                   @map("last_evaluated_at") @db.Timestamptz(3)
  evaluationVersion         Int                         @default(1) @map("evaluation_version")
  addedByUserId             String?                     @map("added_by_user_id") @db.Uuid
  removedByUserId           String?                     @map("removed_by_user_id") @db.Uuid
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                   Int                         @default(1)

  dispatchReview DispatchReview  @relation(fields: [dispatchReviewId], references: [id], onDelete: Cascade)
  workerIdentity WorkerIdentity? @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)
  addedBy        User?           @relation("DispatchCandidateAddedByUser", fields: [addedByUserId], references: [id], onDelete: SetNull)
  removedBy      User?           @relation("DispatchCandidateRemovedByUser", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@unique([dispatchReviewId, candidateSourceReference], map: "dispatch_candidates_review_source_ref_key")
  @@index([dispatchReviewId, shortlistState], map: "dispatch_candidates_dispatch_review_id_shortlist_state_idx")
  @@index([dispatchReviewId, sourceFreshnessAt], map: "dispatch_candidates_dispatch_review_id_source_freshness_at_idx")
  @@index([candidateSourceReference], map: "dispatch_candidates_candidate_source_reference_idx")
  @@index([dispatchReviewId, workerIdentityId, shortlistState], map: "dispatch_candidates_review_worker_shortlist_idx")
  @@map("dispatch_candidates")
}

model WorkerIdentity {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @unique @map("user_id") @db.Uuid
  displayName       String?              @map("display_name")
  preferredLanguage String?              @map("preferred_language")
  status            WorkerIdentityStatus @default(active)
  classification    String               @default("employee") @map("classification")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int                  @default(1)

  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  offers             WorkerOffer[]
  responses          WorkerOfferResponse[]
  assignments        Assignment[]
  attendanceRecords  AttendanceRecord[]
  timesheets         Timesheet[]
  dispatchCandidates DispatchCandidate[]

  savedJobs          WorkerSavedJob[]
  jobInterests       WorkerJobInterest[]
  payouts            WorkerPayout[]
  disputes           WorkerDispute[]
  verifications      WorkerVerification[]
  hrProfile          HrProfile?
  hrCredentials      HrCredential[]
  hrCases            HrCase[]
  hrDocuments        HrDocument[]
  classificationElections WorkerClassificationElection[]
  taxProfile              WorkerTaxProfile?

  @@index([status], map: "worker_identities_status_idx")
  @@map("worker_identities")
}

// Two-channel pay (CRA/RQ): a worker's employee-vs-independent status is a signed, append-only
// election, not a mutable flag. A change supersedes the prior row and writes a new one — the history
// is the audit trail. Payroll reads the single `active` row. See docs/finance/TWO_CHANNEL_PAYROLL_DESIGN.md.
model WorkerClassificationElection {
  id                  String    @id @default(uuid()) @db.Uuid
  workerIdentityId    String    @map("worker_identity_id") @db.Uuid
  classification      String // "employee" | "contractor"
  status              String    @default("active") // "active" | "superseded" | "revoked"
  agreementDocumentId String?   @map("agreement_document_id") @db.Uuid
  agreementVersion    String?   @map("agreement_version")
  determinationRef    String?   @map("determination_ref")
  reason              String?
  effectiveFrom       DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(3)
  electedByUserId     String    @map("elected_by_user_id") @db.Uuid
  approvedByUserId    String?   @map("approved_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workerIdentity WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)

  @@index([workerIdentityId, status], map: "wce_worker_status_idx")
  @@map("worker_classification_elections")
}

// Phase 2b: a contractor's GST/QST registration. Mutable and independent of the (immutable) signed
// classification election. When a contractor is registered, GST (5%) and QST (9.975%) are added to
// their fee, which the platform pays and the contractor remits. BEST-GUESS flow pending CPA sign-off;
// money execution and remittance stay OFF behind the go-live gate.
model WorkerTaxProfile {
  workerIdentityId  String   @id @map("worker_identity_id") @db.Uuid
  gstQstRegistered  Boolean  @default(false) @map("gst_qst_registered")
  gstNumber         String?  @map("gst_number")
  qstNumber         String?  @map("qst_number")
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workerIdentity WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)

  @@map("worker_tax_profiles")
}

// Dynamic offer engine P2 — worker offer preferences (mutable). What a worker needs to accept work,
// fed to the acceptance model. See docs/matching/DYNAMIC_OFFER_ENGINE_DESIGN.md.
model WorkerOfferPreference {
  workerIdentityId   String   @id @map("worker_identity_id") @db.Uuid
  minRatePerHourMinor Int     @default(0) @map("min_rate_per_hour_minor")
  requiresTransport  Boolean  @default(false) @map("requires_transport")
  maxDistanceKm      Int      @default(100) @map("max_distance_km")
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("worker_offer_preferences")
}

// Dynamic offer engine P2 — the append-only offer/outcome log. Every offer the optimizer proposes is
// recorded with the features it saw, the terms, the predicted acceptance, and (later) the outcome.
// THIS is the training set the learned models (P3+) consume. No money flows through this table.
model OfferDecisionEvent {
  id                          String    @id @default(uuid()) @db.Uuid
  jobRequestId                String?   @map("job_request_id") @db.Uuid
  workerIdentityId            String    @map("worker_identity_id") @db.Uuid
  baseRateMinor               Int       @map("base_rate_minor")
  transportAllowanceMinor     Int       @map("transport_allowance_minor")
  bonusMinor                  Int       @map("bonus_minor")
  clientPriceMinor            Int       @map("client_price_minor")
  workerCostMinor             Int       @map("worker_cost_minor")
  marginMinor                 Int       @map("margin_minor")
  acceptanceProbability       Float     @map("acceptance_probability")
  modelKind                   String    @map("model_kind")
  hours                       Int
  distanceKm                  Int       @map("distance_km")
  hoursUntilShift             Int       @map("hours_until_shift")
  willingnessToPayPerHourMinor Int      @map("willingness_to_pay_per_hour_minor")
  featReliability             Float     @map("feat_reliability")
  featRequiresTransport       Boolean   @map("feat_requires_transport")
  featMinRatePerHourMinor     Int       @map("feat_min_rate_per_hour_minor")
  outcome                     String    @default("proposed") // proposed|offered|accepted|declined|ignored|expired
  outcomeAt                   DateTime? @map("outcome_at") @db.Timestamptz(3)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workerIdentityId], map: "ode_worker_idx")
  @@index([jobRequestId], map: "ode_job_idx")
  @@index([outcome], map: "ode_outcome_idx")
  @@map("offer_decision_events")
}

// Dynamic offer engine P3 — the learning loop's model store. Each retrain fits a model on the whole
// offer/outcome history and appends a version; one is active per model type. The optimizer loads the
// active model. No money flows here. See docs/matching/DYNAMIC_OFFER_ENGINE_DESIGN.md.
model MatchingModelVersion {
  id         String   @id @default(uuid()) @db.Uuid
  modelType  String   @map("model_type") // "acceptance" | "wtp"
  weights    Json
  featureDim Int      @map("feature_dim")
  sampleSize Int      @map("sample_size")
  logLoss    Float    @map("log_loss")
  isActive   Boolean  @default(true) @map("is_active")
  trainedAt  DateTime @default(now()) @map("trained_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([modelType, isActive], map: "mmv_type_active_idx")
  @@map("matching_model_versions")
}

// Dynamic offer engine P4b — client intake signals ("what the client needs"), captured from the
// client page and used as the willingness-to-pay ceiling the optimizer stays under. One per job.
// A learned WTP model consumes these once there is client-accept data. No money flows here.
model ClientIntakeSignal {
  jobRequestId                 String   @id @map("job_request_id") @db.Uuid
  organizationId               String?  @map("organization_id") @db.Uuid
  urgency                      String   @default("normal") // low|normal|high|urgent
  budgetFlexibility            String   @default("normal") @map("budget_flexibility") // tight|normal|flexible
  willingnessToPayPerHourMinor Int      @map("willingness_to_pay_per_hour_minor")
  notes                        String?
  updatedByUserId              String?  @map("updated_by_user_id") @db.Uuid
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("client_intake_signals")
}

// Worker-saved marketplace jobs. User-scoped (a worker saves opportunities to revisit).
// Idempotent: one save per (worker, job) via the unique constraint.
model WorkerSavedJob {
  id               String   @id @default(uuid()) @db.Uuid
  workerIdentityId String   @map("worker_identity_id") @db.Uuid
  jobRequestId     String   @map("job_request_id") @db.Uuid
  savedAt          DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)

  worker     WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)
  jobRequest JobRequest     @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@unique([workerIdentityId, jobRequestId], map: "worker_saved_jobs_worker_job_key")
  @@index([workerIdentityId, savedAt], map: "worker_saved_jobs_worker_saved_at_idx")
  @@map("worker_saved_jobs")
}

// ── Verification (provider-neutral trust states) ──
// Real, server-authoritative trust states that drive marketplace badges, dispatch
// eligibility, HR review, and admin supervision. Badges are NEVER inferred from an active
// account, a signed contract, payment, or job postings — only from these records.

enum WorkerVerificationType {
  identity
  background_check
}

// Normalized per-record status. Provider-specific statuses are mapped into these at the
// callback boundary; JobLop core never stores raw vendor status strings as truth.
enum WorkerVerificationStatus {
  unverified
  pending
  verified
  review
  expired
  rejected
}

enum EmployerVerificationStatus {
  unverified
  pending
  business_verified
  review_required
  suspended
  expired
}

// A worker's verification record for a given type (identity / background_check). One active
// record per (worker, type); re-verification transitions the same record + emits events.
model WorkerVerification {
  id               String                   @id @default(uuid()) @db.Uuid
  workerIdentityId String                   @map("worker_identity_id") @db.Uuid
  verificationType WorkerVerificationType   @map("verification_type")
  status           WorkerVerificationStatus @default(unverified)
  provider         String?
  providerReference String?                 @map("provider_reference")
  requestedAt      DateTime?                @map("requested_at") @db.Timestamptz(3)
  completedAt      DateTime?                @map("completed_at") @db.Timestamptz(3)
  expiresAt        DateTime?                @map("expires_at") @db.Timestamptz(3)
  reviewedByUserId String?                  @map("reviewed_by_user_id") @db.Uuid
  // Safe result metadata ONLY (normalized summary). Never raw identity documents.
  resultMetadata   Json?                    @map("result_metadata")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int                      @default(1)

  worker WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)

  @@unique([workerIdentityId, verificationType], map: "worker_verifications_worker_type_key")
  @@index([status], map: "worker_verifications_status_idx")
  @@index([providerReference], map: "worker_verifications_provider_reference_idx")
  @@map("worker_verifications")
}

// An organization's business-verification lifecycle. One per organization; the org itself is
// verified, not merely the user account.
model EmployerVerification {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @unique @map("organization_id") @db.Uuid
  status           EmployerVerificationStatus @default(unverified)
  provider         String?
  providerReference String?                   @map("provider_reference")
  requestedAt      DateTime?                  @map("requested_at") @db.Timestamptz(3)
  completedAt      DateTime?                  @map("completed_at") @db.Timestamptz(3)
  expiresAt        DateTime?                  @map("expires_at") @db.Timestamptz(3)
  reviewedByUserId String?                    @map("reviewed_by_user_id") @db.Uuid
  resultMetadata   Json?                      @map("result_metadata")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int                        @default(1)

  organization EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status], map: "employer_verifications_status_idx")
  @@index([providerReference], map: "employer_verifications_provider_reference_idx")
  @@map("employer_verifications")
}

// Append-only audit of every verification state transition (requested → provider result →
// review → verified/rejected → expiry/reverification). Actor, timestamp, source/provider,
// prior/new state.
model VerificationEvent {
  id               String   @id @default(uuid()) @db.Uuid
  subjectType      String   @map("subject_type") // "worker" | "employer"
  subjectId        String   @map("subject_id") @db.Uuid
  verificationType String?  @map("verification_type")
  source           String // "worker" | "employer" | "admin" | "provider" | "system"
  priorStatus      String?  @map("prior_status")
  newStatus        String   @map("new_status")
  provider         String?
  providerReference String? @map("provider_reference")
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  detail           Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt], map: "verification_events_subject_idx")
  @@map("verification_events")
}

// ── HR domain (HR-1 foundation) ──
// HR is a GOVERNED domain. It owns the worker HR/employment profile, credentials, standing,
// and cases. It CONSUMES authoritative verification state (built separately) — it never owns
// identity/background-check provider integrations, marketplace, dispatch, offers, assignments,
// payroll, or payments. HR standing is NORMALIZED and independent from verification: an
// identity-verified worker is NOT automatically ACTIVE.

enum HrStanding {
  active
  review_required
  restricted
  suspended
  inactive
}

// Credential status. Expiry is first-class: a once-valid credential is never permanently
// valid. "expiring" is derived at read (within the warning window); history is preserved via
// the renewal chain (supersededById), not by mutating the old record's identity.
enum HrCredentialStatus {
  valid
  expiring
  expired
  renewed
  replaced
  revoked
}

enum HrCaseStatus {
  opened
  under_review
  action_required
  resolved
  closed
}

// One authoritative HR profile per worker identity (no duplicate worker accounts). Standing
// lives here; every change is audited via HrEvent.
model HrProfile {
  id               String     @id @default(uuid()) @db.Uuid
  workerIdentityId String     @unique @map("worker_identity_id") @db.Uuid
  standing         HrStanding @default(active)
  standingReason   String?    @map("standing_reason")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int        @default(1)

  worker WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)

  @@index([standing, updatedAt], map: "hr_profiles_standing_updated_at_idx")
  @@map("hr_profiles")
}

// A worker credential/qualification. Multiple per worker. Renewal creates a NEW record and
// links the old one via supersededById (history preserved).
model HrCredential {
  id                 String             @id @default(uuid()) @db.Uuid
  workerIdentityId   String             @map("worker_identity_id") @db.Uuid
  credentialType     String             @map("credential_type")
  issuer             String?
  issuedAt           DateTime?          @map("issued_at") @db.Timestamptz(3)
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz(3)
  status             HrCredentialStatus @default(valid)
  // Reference to an authoritative verification (HR does not own verification). Never a raw
  // document — a pointer + safe metadata only.
  verificationReference String?         @map("verification_reference")
  safeMetadata       Json?              @map("safe_metadata")
  supersededById     String?            @unique @map("superseded_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int                @default(1)

  worker       WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)
  supersededBy HrCredential?  @relation("HrCredentialRenewal", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   HrCredential?  @relation("HrCredentialRenewal")

  @@index([workerIdentityId, credentialType], map: "hr_credentials_worker_type_idx")
  // Expiry/review queue: index by (status, expires_at) so it can be processed in bounded batches.
  @@index([status, expiresAt], map: "hr_credentials_status_expires_at_idx")
  @@map("hr_credentials")
}

// A governed HR case. The row holds current state; every transition is an append-only
// HrEvent (actor, prior→new, reason). Material history is never silently overwritten.
model HrCase {
  id               String       @id @default(uuid()) @db.Uuid
  workerIdentityId String       @map("worker_identity_id") @db.Uuid
  caseType         String       @map("case_type")
  status           HrCaseStatus @default(opened)
  reason           String?
  openedByUserId   String       @map("opened_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int          @default(1)

  worker WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)

  @@index([workerIdentityId, createdAt], map: "hr_cases_worker_created_at_idx")
  // Review queue: index by (status, updated_at) for bounded, paginated processing.
  @@index([status, updatedAt], map: "hr_cases_status_updated_at_idx")
  @@map("hr_cases")
}

// Append-only audit for every governed HR transition (standing / credential / case).
model HrEvent {
  id               String   @id @default(uuid()) @db.Uuid
  subjectType      String   @map("subject_type") // "profile" | "credential" | "case"
  subjectId        String   @map("subject_id") @db.Uuid
  workerIdentityId String   @map("worker_identity_id") @db.Uuid
  eventType        String   @map("event_type")
  priorState       String?  @map("prior_state")
  newState         String   @map("new_state")
  reason           String?
  source           String // "worker" | "hr_admin" | "platform_admin" | "system"
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  correlationId    String?  @map("correlation_id")
  detail           Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workerIdentityId, createdAt], map: "hr_events_worker_created_at_idx")
  @@index([subjectType, subjectId, createdAt], map: "hr_events_subject_idx")
  @@map("hr_events")
}

// ── HR-3: Documents & Compliance ──
// Governed HR document metadata. File CONTENTS are NEVER stored here — only a provider
// storageReference + checksum. The document-storage provider is provider-neutral (fixture in
// dev; a real encrypted-at-rest, signed-URL, malware-scanned provider swaps in behind the
// same seam). Compliance requirements are DATA keyed by jurisdiction/role/effective-date —
// no country's rules are hard-coded into the core model.

enum HrDocumentStatus {
  required
  submitted
  under_review
  accepted
  rejected
  expiring
  expired
  superseded
  revoked
}

model HrDocument {
  id                   String           @id @default(uuid()) @db.Uuid
  workerIdentityId     String           @map("worker_identity_id") @db.Uuid
  documentType         String           @map("document_type")
  issuingAuthority     String?          @map("issuing_authority")
  jurisdiction         String?          // e.g. "CA-QC" (ISO-ish); never a hard-coded rule
  issuedAt             DateTime?        @map("issued_at") @db.Timestamptz(3)
  expiresAt            DateTime?        @map("expires_at") @db.Timestamptz(3)
  status               HrDocumentStatus @default(submitted)
  // A pointer into the secure document-storage provider — NEVER file bytes.
  storageReference     String?          @map("storage_reference")
  checksum             String?          // integrity hash (validation is a provider concern)
  verificationReference String?         @map("verification_reference")
  source               String           @default("worker") // worker | hr_admin | employer | system
  reviewedByUserId     String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewReason         String?          @map("review_reason")
  supersededById       String?          @unique @map("superseded_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int              @default(1)

  worker       WorkerIdentity @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)
  supersededBy HrDocument?    @relation("HrDocumentReplacement", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   HrDocument?    @relation("HrDocumentReplacement")

  @@index([workerIdentityId, documentType], map: "hr_documents_worker_type_idx")
  // Review + expiry queues (bounded, indexed): (status, updated_at) and (status, expires_at).
  @@index([status, updatedAt], map: "hr_documents_status_updated_at_idx")
  @@index([status, expiresAt], map: "hr_documents_status_expires_at_idx")
  @@map("hr_documents")
}

// A compliance requirement as DATA (adapter mechanism, not hard-coded law). The resolver
// selects requirements matching (jurisdiction, roleCategory, worksiteRef, effective date).
model ComplianceRequirement {
  id                    String    @id @default(uuid()) @db.Uuid
  key                   String    @unique
  description           String?
  jurisdiction          String    // e.g. "CA-QC" — data, not a universal rule
  roleCategory          String?   @map("role_category")
  employerPolicyRef     String?   @map("employer_policy_ref")
  worksiteRef           String?   @map("worksite_ref")
  requiredDocumentType  String?   @map("required_document_type")
  requiredCredentialType String?  @map("required_credential_type")
  effectiveFrom         DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(3)
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([jurisdiction, roleCategory, active], map: "compliance_requirements_jurisdiction_role_idx")
  @@map("compliance_requirements")
}

// Append-only audit for governed document transitions.
model HrDocumentEvent {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  workerIdentityId String   @map("worker_identity_id") @db.Uuid
  eventType        String   @map("event_type")
  priorState       String?  @map("prior_state")
  newState         String   @map("new_state")
  reason           String?
  source           String
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  documentReference String? @map("document_reference")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workerIdentityId, createdAt], map: "hr_document_events_worker_created_at_idx")
  @@index([documentId, createdAt], map: "hr_document_events_document_idx")
  @@map("hr_document_events")
}

// Marketplace source of an interest record. Kept as an enum so future intake channels
// (referral, agency import, etc.) never masquerade as a worker's own marketplace action.
enum WorkerJobInterestSource {
  marketplace
}

// Governed marketplace INTENT, distinct from the offer/assignment state machines. A worker
// expressing interest never creates an offer or an assignment — platform dispatch reviews,
// then issues a governed offer through the existing worker-offer service. These statuses are
// marketplace intent only.
enum WorkerJobInterestStatus {
  submitted
  under_review
  shortlisted
  not_selected
  withdrawn
  offer_created
  offer_accepted
}

model WorkerJobInterest {
  id                 String                  @id @default(uuid()) @db.Uuid
  workerIdentityId   String                  @map("worker_identity_id") @db.Uuid
  jobRequestId       String                  @map("job_request_id") @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  status             WorkerJobInterestStatus @default(submitted)
  source             WorkerJobInterestSource @default(marketplace)
  distanceKmAtInterest Float?                @map("distance_km_at_interest")
  // Eligibility result captured at the moment interest was accepted (audit snapshot).
  eligibilitySnapshot Json?                  @map("eligibility_snapshot")
  // Logical link to the governed offer once one is created for this interest (no FK — the
  // offer lifecycle stays authoritative in its own model).
  workerOfferId      String?                 @map("worker_offer_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int                     @default(1)

  worker       WorkerIdentity       @relation(fields: [workerIdentityId], references: [id], onDelete: Cascade)
  jobRequest   JobRequest           @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  organization EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // At most one ACTIVE interest per (worker, job) — enforced by a partial unique index in
  // the migration (WHERE status NOT IN ('withdrawn','not_selected')). Re-expressing after a
  // withdrawal/rejection is a new record (audit-friendly).
  @@index([workerIdentityId, createdAt], map: "worker_job_interests_worker_created_at_idx")
  @@index([jobRequestId, status], map: "worker_job_interests_job_status_idx")
  @@map("worker_job_interests")
}

model WorkerOffer {
  id                    String            @id @default(uuid()) @db.Uuid
  dispatchReviewId      String            @map("dispatch_review_id") @db.Uuid
  jobRequestId          String            @map("job_request_id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  residenceId           String            @map("residence_id") @db.Uuid
  departmentId          String            @map("department_id") @db.Uuid
  workerIdentityId      String            @map("worker_identity_id") @db.Uuid
  currentTermsVersionId String?           @unique @map("current_terms_version_id") @db.Uuid
  status                WorkerOfferStatus @default(draft)
  expiresAt             DateTime          @map("expires_at") @db.Timestamptz(3)
  approvedAt            DateTime?         @map("approved_at") @db.Timestamptz(3)
  sentAt                DateTime?         @map("sent_at") @db.Timestamptz(3)
  deliveredAt           DateTime?         @map("delivered_at") @db.Timestamptz(3)
  viewedAt              DateTime?         @map("viewed_at") @db.Timestamptz(3)
  respondedAt           DateTime?         @map("responded_at") @db.Timestamptz(3)
  withdrawnAt           DateTime?         @map("withdrawn_at") @db.Timestamptz(3)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdByUserId       String            @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?           @map("updated_by_user_id") @db.Uuid
  approvedByUserId      String?           @map("approved_by_user_id") @db.Uuid
  sentByUserId          String?           @map("sent_by_user_id") @db.Uuid
  withdrawnByUserId     String?           @map("withdrawn_by_user_id") @db.Uuid
  cancelledByUserId     String?           @map("cancelled_by_user_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version               Int               @default(1)

  dispatchReview      DispatchReview               @relation(fields: [dispatchReviewId], references: [id], onDelete: Restrict)
  jobRequest          JobRequest                   @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  organization        EmployerOrganization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  residence           Residence                    @relation(fields: [organizationId, residenceId], references: [organizationId, id], onDelete: Restrict)
  department          Department                   @relation(fields: [organizationId, residenceId, departmentId], references: [organizationId, residenceId, id], onDelete: Restrict)
  workerIdentity      WorkerIdentity               @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)
  currentTermsVersion WorkerOfferTermsVersion?     @relation("CurrentWorkerOfferTerms", fields: [currentTermsVersionId], references: [id], onDelete: Restrict)
  termsVersions       WorkerOfferTermsVersion[]    @relation("WorkerOfferTerms")
  deliveryAttempts    WorkerOfferDeliveryAttempt[]
  responses           WorkerOfferResponse[]
  assignment          Assignment?
  createdBy           User                         @relation("WorkerOfferCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User?                        @relation("WorkerOfferUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  approvedBy          User?                        @relation("WorkerOfferApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  sentBy              User?                        @relation("WorkerOfferSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)
  withdrawnBy         User?                        @relation("WorkerOfferWithdrawnByUser", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)
  cancelledBy         User?                        @relation("WorkerOfferCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@unique([dispatchReviewId, workerIdentityId], map: "worker_offers_dispatch_worker_key")
  @@unique([id, dispatchReviewId, jobRequestId, organizationId, residenceId, departmentId, workerIdentityId], map: "worker_offers_operational_scope_key")
  @@index([dispatchReviewId, status], map: "worker_offers_dispatch_review_id_status_idx")
  @@index([organizationId, status, updatedAt], map: "worker_offers_organization_id_status_updated_at_idx")
  @@index([workerIdentityId, status, expiresAt], map: "worker_offers_worker_identity_id_status_expires_at_idx")
  @@index([jobRequestId, status], map: "worker_offers_job_request_id_status_idx")
  @@map("worker_offers")
}

model WorkerOfferTermsVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  workerOfferId        String   @map("worker_offer_id") @db.Uuid
  versionNumber        Int      @map("version_number")
  workerVisibleTitle   String   @map("worker_visible_title")
  workerVisibleSummary String?  @map("worker_visible_summary")
  timezone             String
  startAt              DateTime @map("start_at") @db.Timestamptz(3)
  endAt                DateTime @map("end_at") @db.Timestamptz(3)
  workGroupId          String   @map("work_group_id") @db.Uuid
  roleDefinitionId     String   @map("role_definition_id") @db.Uuid
  compensationSummary  String?  @map("compensation_summary")
  policySummary        String?  @map("policy_summary")
  createdByUserId      String   @map("created_by_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workerOffer     WorkerOffer           @relation("WorkerOfferTerms", fields: [workerOfferId], references: [id], onDelete: Cascade)
  currentForOffer WorkerOffer?          @relation("CurrentWorkerOfferTerms")
  workGroup       WorkGroup             @relation(fields: [workGroupId], references: [id], onDelete: Restrict)
  roleDefinition  RoleDefinition        @relation(fields: [workGroupId, roleDefinitionId], references: [workGroupId, id], onDelete: Restrict)
  createdBy       User                  @relation("WorkerOfferTermsCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responses       WorkerOfferResponse[]
  assignments     Assignment[]

  @@unique([workerOfferId, versionNumber], map: "worker_offer_terms_offer_version_key")
  @@index([workerOfferId, createdAt], map: "worker_offer_terms_worker_offer_id_created_at_idx")
  @@map("worker_offer_terms_versions")
}

model WorkerOfferDeliveryAttempt {
  id               String                    @id @default(uuid()) @db.Uuid
  workerOfferId    String                    @map("worker_offer_id") @db.Uuid
  status           WorkerOfferDeliveryStatus @default(pending)
  providerBoundary String                    @default("abstract") @map("provider_boundary")
  reason           String?
  attemptedAt      DateTime?                 @map("attempted_at") @db.Timestamptz(3)
  deliveredAt      DateTime?                 @map("delivered_at") @db.Timestamptz(3)
  failedAt         DateTime?                 @map("failed_at") @db.Timestamptz(3)
  createdByUserId  String?                   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  workerOffer WorkerOffer @relation(fields: [workerOfferId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("WorkerOfferDeliveryCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workerOfferId, createdAt], map: "worker_offer_delivery_worker_offer_id_created_at_idx")
  @@index([status, createdAt], map: "worker_offer_delivery_status_created_at_idx")
  @@map("worker_offer_delivery_attempts")
}

model WorkerOfferResponse {
  id               String                  @id @default(uuid()) @db.Uuid
  workerOfferId    String                  @map("worker_offer_id") @db.Uuid
  workerIdentityId String                  @map("worker_identity_id") @db.Uuid
  termsVersionId   String                  @map("terms_version_id") @db.Uuid
  responseType     WorkerOfferResponseType @map("response_type")
  reason           String?
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  workerOffer    WorkerOffer             @relation(fields: [workerOfferId], references: [id], onDelete: Restrict)
  workerIdentity WorkerIdentity          @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)
  termsVersion   WorkerOfferTermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)

  @@unique([workerOfferId], map: "worker_offer_responses_worker_offer_id_key")
  @@index([workerIdentityId, createdAt], map: "worker_offer_responses_worker_identity_id_created_at_idx")
  @@map("worker_offer_responses")
}

model Assignment {
  id                             String           @id @default(uuid()) @db.Uuid
  jobRequestId                   String           @map("job_request_id") @db.Uuid
  dispatchReviewId               String           @map("dispatch_review_id") @db.Uuid
  workerOfferId                  String           @unique @map("worker_offer_id") @db.Uuid
  workerOfferTermsVersionId      String           @map("worker_offer_terms_version_id") @db.Uuid
  workerIdentityId               String           @map("worker_identity_id") @db.Uuid
  organizationId                 String           @map("organization_id") @db.Uuid
  residenceId                    String           @map("residence_id") @db.Uuid
  departmentId                   String           @map("department_id") @db.Uuid
  workGroupId                    String           @map("work_group_id") @db.Uuid
  roleDefinitionId               String           @map("role_definition_id") @db.Uuid
  status                         AssignmentStatus @default(confirmed)
  confirmedStartAt               DateTime         @map("confirmed_start_at") @db.Timestamptz(3)
  confirmedEndAt                 DateTime         @map("confirmed_end_at") @db.Timestamptz(3)
  timezone                       String
  confirmedTitle                 String           @map("confirmed_title")
  confirmedRoleSummary           String?          @map("confirmed_role_summary")
  confirmedWorksiteSummary       String?          @map("confirmed_worksite_summary")
  confirmedDepartmentSummary     String?          @map("confirmed_department_summary")
  confirmedResponsibilitySummary String?          @map("confirmed_responsibility_summary")
  confirmedPolicySummary         String?          @map("confirmed_policy_summary")
  confirmedCompensationSummary   String?          @map("confirmed_compensation_summary")
  validationSnapshot             Json?            @map("validation_snapshot")
  capacityCheckedAt              DateTime         @map("capacity_checked_at") @db.Timestamptz(3)
  conflictCheckedAt              DateTime         @map("conflict_checked_at") @db.Timestamptz(3)
  confirmedAt                    DateTime         @map("confirmed_at") @db.Timestamptz(3)
  workerAcknowledgedAt           DateTime?        @map("worker_acknowledged_at") @db.Timestamptz(3)
  readyForAttendanceAt           DateTime?        @map("ready_for_attendance_at") @db.Timestamptz(3)
  attendanceWindowStartedAt      DateTime?        @map("attendance_window_started_at") @db.Timestamptz(3)
  attendanceHandoffAt            DateTime?        @map("attendance_handoff_at") @db.Timestamptz(3)
  workerWithdrawnAt              DateTime?        @map("worker_withdrawn_at") @db.Timestamptz(3)
  cancelledAt                    DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  replacementRequiredAt          DateTime?        @map("replacement_required_at") @db.Timestamptz(3)
  closedAt                       DateTime?        @map("closed_at") @db.Timestamptz(3)
  cancellationReasonCategory     String?          @map("cancellation_reason_category")
  createdByUserId                String           @map("created_by_user_id") @db.Uuid
  updatedByUserId                String?          @map("updated_by_user_id") @db.Uuid
  confirmedByUserId              String?          @map("confirmed_by_user_id") @db.Uuid
  cancelledByUserId              String?          @map("cancelled_by_user_id") @db.Uuid
  createdAt                      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                        Int              @default(1)

  jobRequest              JobRequest              @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  dispatchReview          DispatchReview          @relation(fields: [dispatchReviewId], references: [id], onDelete: Restrict)
  workerOffer             WorkerOffer             @relation(fields: [workerOfferId], references: [id], onDelete: Restrict)
  workerOfferTermsVersion WorkerOfferTermsVersion @relation(fields: [workerOfferTermsVersionId], references: [id], onDelete: Restrict)
  workerIdentity          WorkerIdentity          @relation(fields: [workerIdentityId], references: [id], onDelete: Restrict)
  organization            EmployerOrganization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  residence               Residence               @relation(fields: [organizationId, residenceId], references: [organizationId, id], onDelete: Restrict)
  department              Department              @relation(fields: [organizationId, residenceId, departmentId], references: [organizationId, residenceId, id], onDelete: Restrict)
  workGroup               WorkGroup               @relation(fields: [workGroupId], references: [id], onDelete: Restrict)
  roleDefinition          RoleDefinition          @relation(fields: [workGroupId, roleDefinitionId], references: [workGroupId, id], onDelete: Restrict)
  createdBy               User                    @relation("AssignmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy               User?                   @relation("AssignmentUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
