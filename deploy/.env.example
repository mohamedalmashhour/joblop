# JobLop — Mac self-host env (staging tier). Copy to deploy/.env and fill in.
#   cd deploy && cp .env.example .env
# Docker Compose reads this file for both ${...} substitution and the apps' runtime env.
# NEVER commit deploy/.env (it holds secrets) — it is gitignored.

# ── Infrastructure (required) ────────────────────────────────────────────────
# Strong Postgres password (used by the db container + DATABASE_URL). Generate one:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Cloudflare Tunnel token. Create the tunnel in the Cloudflare dashboard
# (Zero Trust → Networks → Tunnels → Create), then paste its connector token here.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Public URLs (your domain) ────────────────────────────────────────────────
# The public worker app URL — used for offer-email links and worker ingress.
# Match the hostname you map in the Cloudflare tunnel (e.g. https://app.joblop.com).
WORKER_WEB_ORIGIN=https://app.joblop.com
# Optional: public origin for password-reset links (https in staging/production).
# PASSWORD_RESET_PUBLIC_ORIGIN=https://app.joblop.com

# Session signing secret — recommended for staging so sessions survive restarts.
# Generate: openssl rand -hex 32
# SESSION_SECRET=

# ── Worker notifications: Resend email (recommended, free) ───────────────────
# Create at resend.com → API Keys; verify your sending domain under Resend → Domains.
# One Resend account can hold several verified domains, so the org may REUSE a single
# shared account API key across platforms — but each platform must send from its OWN
# verified domain (keep JobLop's sender on a joblop.com domain, never another brand's).
RESEND_API_KEY=
# Must be on your Resend-verified domain:
EMAIL_FROM=JobLop <offers@mail.joblop.com>

# ── Google Maps (OPTIONAL — the worksite map works with NO key) ──────────────
# Job orders show a keyless Google map (output=embed) + a "Get directions & live
# travel time" link out of the box, so you can launch WITHOUT a Maps key or billing.
# Set a key ONLY to add the optional enhancements: static-map images (for emails/PDFs)
# and an inline precomputed Distance Matrix ETA. If set, enable Maps Static API +
# Distance Matrix API + Geocoding API, server-side only, and restrict the key.
# GOOGLE_MAPS_API_KEY=

# ── Payments: Stripe TEST mode (optional; staging allows test mode only) ─────
# Leave disabled until you add test keys. NEVER put live (sk_live_) keys here.
STRIPE_TEST_MODE_ENABLED=disabled
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_TEST_ACCOUNT_REFERENCE=acct_...

# ── Control Room share links (optional) ──────────────────────────────────────
# Enables signed, party-scoped transaction statement links. ≥32 chars:
#   openssl rand -hex 32
# CONTROL_ROOM_SHARE_SECRET=
# Require finance authority to mint links (recommended on once you're live):
# CONTROL_ROOM_MINT_REQUIRE_FINANCE=enabled

# ── Legal version display (staging/testing) ──────────────────────────────────
# Draft version ids so the /terms and /privacy pages show a configured version while
# testing flow. Replace with counsel-finalized ids before any production activation;
# Canada's production activation gate stays closed regardless of these.
TERMS_VERSION=ca-terms-draft-2026-10
PRIVACY_NOTICE_VERSION=ca-privacy-draft-2026-10
