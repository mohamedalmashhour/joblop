model AuditEvent {
  id                    String      @id @default(uuid()) @db.Uuid
  actorReferenceId      String      @map("actor_reference_id") @db.Uuid
  organizationId        String?     @map("organization_id") @db.Uuid
  entityType            String      @map("entity_type")
  entityId              String      @map("entity_id") @db.Uuid
  entityPublicReference String?     @map("entity_public_reference")
  action                String
  priorState            String?     @map("prior_state")
  newState              String?     @map("new_state")
  reason                String?
  source                AuditSource
  correlationId         String      @map("correlation_id")
  policyVersion         String?     @map("policy_version")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actorReference AuditActorReference   @relation(fields: [actorReferenceId], references: [id], onDelete: Restrict)
  // organizationId is an immutable historical snapshot, not a live reference: audit_events are
  // append-only (BEFORE UPDATE/DELETE triggers), so a SetNull FK made org deletion impossible.
  // Kept as a plain column with no FK; the org reference is preserved even after the org is gone.

  @@index([organizationId, createdAt], map: "audit_events_organization_id_created_at_idx")
  @@index([entityType, entityId, createdAt], map: "audit_events_entity_type_entity_id_created_at_idx")
  @@index([entityPublicReference], map: "audit_events_entity_public_reference_idx")
  @@index([correlationId], map: "audit_events_correlation_id_idx")
  @@map("audit_events")
}

