{
  "name": "resident-workforce-os",
  "version": "0.1.0-foundation",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.20.2 <21",
    "pnpm": "10.33.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5 <6": "5.0.9",
      "fast-uri@>=3 <4": "3.1.5",
      "fast-uri@>=4 <5": "4.1.2",
      "find-my-way@>=9 <10": "9.7.0",
      "minimatch@>=9 <10": "10.2.5",
      "postcss@>=8 <9": "8.5.23",
      "sharp@>=0.34 <0.36": "0.35.0",
      "tar@>=7 <8": "7.5.21",
      "uuid@>=7 <12": "11.1.1"
    }
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:postgres:required": "node --import tsx scripts/run-postgres-required-tests.ts",
    "test:e2e:browser": "node --import tsx scripts/validate-browser-e2e-inputs.ts && playwright test --tsconfig tsconfig.base.json --config tests/e2e/playwright.config.mjs",
    "e2e:browser:prepare": "node --import tsx scripts/validate-browser-e2e-inputs.ts && node tests/e2e/browser/reset-cli.mjs prepare",
    "e2e:browser:cleanup": "node tests/e2e/browser/reset-cli.mjs cleanup",
    "test:e2e:native": "node --import tsx scripts/run-native-e2e.ts",
    "test:stripe:network": "vitest run --config vitest.external.config.ts apps/api/src/stripeTestProvider.network.test.ts",
    "build": "pnpm -r --if-present build",
    "audit:dependencies": "pnpm audit && pnpm audit --prod",
    "diagnose:production-db": "node --import tsx scripts/diagnose-production-database.ts",
    "validate:evidence": "node --import tsx scripts/validate-external-evidence.ts",
    "validate:contract-kit-c3": "node --import tsx scripts/validate-contract-kit-c3.ts",
    "validate:env": "node --import tsx scripts/validate-env.ts",
    "validate:boundaries": "node --import tsx scripts/validate-boundaries.ts",
    "validate:migrations": "node --import tsx scripts/validate-migration-integrity.ts",
    "validate:containers:static": "vitest run scripts/container-packaging.test.ts apps/mobile/server.test.ts apps/employer/app/health/route.test.ts apps/employer/app/ready/route.test.ts apps/admin/app/health/route.test.ts apps/admin/app/ready/route.test.ts",
    "validate:containers:runtime": "node scripts/validate-containers.mjs",
    "validate:staging": "pnpm validate:env && pnpm validate:boundaries && pnpm validate:migrations && node --import tsx scripts/validate-staging.ts",
    "db:restore:rehearse": "node --import tsx scripts/rehearse-database-restore.ts",
    "qa-reset:postgres:validate": "bash scripts/validate-qa-reset-local-postgres.sh",
    "bootstrap:first-admin": "node --import tsx scripts/bootstrap-first-platform-admin.ts",
    "scan:secrets": "node --import tsx scripts/scan-secrets.ts",
    "scan:public-bundles": "node --import tsx scripts/validate-public-bundles.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:env && pnpm validate:boundaries && pnpm validate:migrations && pnpm scan:secrets && pnpm build && pnpm scan:public-bundles",
    "test:e2e:local": "RWOS_LOCAL_E2E=enabled node --import tsx tests/e2e/local/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.20",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.19.8",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  }
}
