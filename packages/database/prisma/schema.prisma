  periodEnd          DateTime            @map("period_end") @db.Timestamptz(3)
  timezone           String
  status             PayrollPeriodStatus @default(open)
  currency           String
  ruleProviderKey    String              @map("rule_provider_key")
  ruleProviderVersion String             @map("rule_provider_version")
  synthetic          Boolean             @default(true)
  createdByUserId    String              @map("created_by_user_id") @db.Uuid
  reviewedByUserId   String?             @map("reviewed_by_user_id") @db.Uuid
  approvedByUserId   String?             @map("approved_by_user_id") @db.Uuid
  lockedByUserId     String?             @map("locked_by_user_id") @db.Uuid
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(3)
  lockedAt           DateTime?           @map("locked_at") @db.Timestamptz(3)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  calculations       PayrollCalculation[]

  @@unique([organizationId, jurisdictionCountry, jurisdictionRegion, periodStart, periodEnd], map: "payroll_periods_org_jurisdiction_window_key")
  @@index([organizationId, status, periodStart], map: "payroll_periods_org_status_start_idx")
  @@index([jurisdictionCountry, jurisdictionRegion, status], map: "payroll_periods_jurisdiction_status_idx")
  @@index([status, periodStart], map: "payroll_periods_status_start_idx")
  @@map("payroll_periods")
}

model PayrollCalculation {
  id                  String                   @id @default(uuid()) @db.Uuid
  payrollPeriodId     String                   @map("payroll_period_id") @db.Uuid
  organizationId      String                   @map("organization_id") @db.Uuid
  workerIdentityId    String                   @map("worker_identity_id") @db.Uuid
  revision            Int
  status              PayrollCalculationStatus @default(calculated)
  jurisdictionCountry String                   @map("jurisdiction_country")
  jurisdictionRegion  String                   @map("jurisdiction_region")
  ruleProviderKey     String                   @map("rule_provider_key")
  ruleProviderVersion String                   @map("rule_provider_version")
  calculationPolicyVersion String              @map("calculation_policy_version")
  workerClassification String                  @default("employee") @map("worker_classification")
  currency            String
  grossPayMinor       Int                      @map("gross_pay_minor")
  totalDeductionsMinor Int                     @map("total_deductions_minor")
  netPayMinor         Int                      @map("net_pay_minor")
  totalEmployerCostMinor Int                   @map("total_employer_cost_minor")
  synthetic           Boolean                  @default(true)
  calculatedAt        DateTime                 @map("calculated_at") @db.Timestamptz(3)
  createdByUserId     String                   @map("created_by_user_id") @db.Uuid
  reviewedByUserId    String?                  @map("reviewed_by_user_id") @db.Uuid
  approvedByUserId    String?                  @map("approved_by_user_id") @db.Uuid
  rejectedByUserId    String?                  @map("rejected_by_user_id") @db.Uuid
  approvedAt          DateTime?                @map("approved_at") @db.Timestamptz(3)
  rejectedAt          DateTime?                @map("rejected_at") @db.Timestamptz(3)
  supersededById      String?                  @map("superseded_by_id") @db.Uuid
  reviewNote          String?                  @map("review_note")
  // Deterministic fingerprint over the immutable inputs + outputs — detects accidental drift and
  // proves a replay reproduced the same result. Not a cryptographic financial signature.
  calculationFingerprint String                @default("") @map("calculation_fingerprint")
  // ── HR-5.1 Chunk 3: governed revision / correction lineage ──
  // familyRootId groups every revision + adjustment for one (period, worker) line. correctionType
  // distinguishes an ordinary pre-lock revision from an explicit post-lock adjustment. Deltas are
  // signed by DIRECTION (credit/debit) + non-negative absolute Money — never negative Money.
  familyRootId        String                   @default("00000000-0000-0000-0000-000000000000") @map("family_root_id") @db.Uuid
  previousCalculationId String?                @map("previous_calculation_id") @db.Uuid
  previousFingerprint String?                  @map("previous_fingerprint")
  correctionType      String?                  @map("correction_type")
  correctionReason    String?                  @map("correction_reason")
  correctedByUserId   String?                  @map("corrected_by_user_id") @db.Uuid
  correctedAt         DateTime?                @map("corrected_at") @db.Timestamptz(3)
  correlationKey      String?                  @map("correlation_key")
  adjustsCalculationId String?                 @map("adjusts_calculation_id") @db.Uuid
  adjustmentNetDirection String?               @map("adjustment_net_direction")
  adjustmentNetDeltaMinor Int?                 @map("adjustment_net_delta_minor")
  adjustmentGrossDirection String?             @map("adjustment_gross_direction")
  adjustmentGrossDeltaMinor Int?               @map("adjustment_gross_delta_minor")
  adjustmentDeductionsDirection String?        @map("adjustment_deductions_direction")
  adjustmentDeductionsDeltaMinor Int?          @map("adjustment_deductions_delta_minor")
  adjustmentEmployerCostDirection String?      @map("adjustment_employer_cost_direction")
  adjustmentEmployerCostDeltaMinor Int?        @map("adjustment_employer_cost_delta_minor")
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  payrollPeriod       PayrollPeriod            @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  workedTimeRefs      PayrollWorkedTimeReference[]
  earningLines        PayrollEarningLine[]
  deductionLines      PayrollDeductionLine[]
  employerCostLines   PayrollEmployerCostLine[]

  @@unique([payrollPeriodId, workerIdentityId, revision], map: "payroll_calculations_period_worker_revision_key")
  @@index([organizationId, payrollPeriodId], map: "payroll_calculations_org_period_idx")
  @@index([workerIdentityId, payrollPeriodId], map: "payroll_calculations_worker_period_idx")
  @@index([payrollPeriodId, status], map: "payroll_calculations_period_status_idx")
  @@index([jurisdictionCountry, jurisdictionRegion], map: "payroll_calculations_jurisdiction_idx")
  @@index([familyRootId, revision], map: "payroll_calculations_family_revision_idx")
  @@index([adjustsCalculationId], map: "payroll_calculations_adjusts_idx")
  @@map("payroll_calculations")
}

// The exact approved worked-time that fed a calculation, snapshotted with its version so a later
// attendance/timesheet change cannot silently re-base an existing calculation.
// Immutable time + RATE snapshot per approved timesheet that fed a calculation. Captures the exact
// shift window, role scope, and the governed EmployerContract rate effective at the shift's start
// instant — so a later contract/rate change can never re-base an existing calculation, and the
// calculation is historically reproducible from its own snapshot.
model PayrollWorkedTimeReference {
  id                  String             @id @default(uuid()) @db.Uuid
  payrollCalculationId String            @map("payroll_calculation_id") @db.Uuid
  timesheetId         String             @map("timesheet_id") @db.Uuid
  timesheetVersion    Int                @map("timesheet_version")
  timesheetStatus     String             @map("timesheet_status")
  payableMinutes      Int                @map("payable_minutes")
  billableMinutes     Int                @map("billable_minutes")
  scheduledStartAt    DateTime           @map("scheduled_start_at") @db.Timestamptz(3)
  scheduledEndAt      DateTime           @map("scheduled_end_at") @db.Timestamptz(3)
  assignmentId        String             @map("assignment_id") @db.Uuid
  workGroupId         String             @map("work_group_id") @db.Uuid
  roleDefinitionId    String             @map("role_definition_id") @db.Uuid
  residenceId         String             @map("residence_id") @db.Uuid
  // rate snapshot (the committed EmployerContract rate that governed this shift)
  compensationType    String             @default("hourly") @map("compensation_type")
  contractId          String             @map("contract_id") @db.Uuid
  contractVersion     String             @map("contract_version")
  contractEffectiveFrom DateTime         @map("contract_effective_from") @db.Timestamptz(3)
  appliedHourlyRateMinor Int             @map("applied_hourly_rate_minor")
  currency            String
  sourceEffectiveInstant DateTime        @map("source_effective_instant") @db.Timestamptz(3)

  payrollCalculation  PayrollCalculation @relation(fields: [payrollCalculationId], references: [id], onDelete: Cascade)

  @@index([payrollCalculationId], map: "payroll_worked_time_refs_calculation_idx")
  @@index([timesheetId], map: "payroll_worked_time_refs_timesheet_idx")
  @@map("payroll_worked_time_references")
}

model PayrollEarningLine {
  id                  String             @id @default(uuid()) @db.Uuid
