model User {
  id              String     @id @default(uuid()) @db.Uuid
  publicId        String     @unique @map("public_id")
  emailNormalized String     @unique @map("email_normalized")
  displayName     String?    @map("display_name")
  status          UserStatus @default(email_verification_pending)
  primaryLanguage String?    @map("primary_language")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt      DateTime?  @map("disabled_at") @db.Timestamptz(3)
  closedAt        DateTime?  @map("closed_at") @db.Timestamptz(3)

  identities                    UserIdentity[]
  sessions                      Session[]
  emailVerificationCodes        EmailVerificationCode[]
  passwordResetTokens           PasswordResetToken[]
  createdOrganizations          EmployerOrganization[]       @relation("EmployerOrganizationCreatedByUser")
  reviewedOrganizations         EmployerOrganization[]       @relation("EmployerOrganizationReviewedByUser")
  memberships                   OrganizationMembership[]     @relation("OrganizationMembershipUser")
  invitedMemberships            OrganizationMembership[]     @relation("OrganizationMembershipInvitedByUser")
  createdResidences             Residence[]                  @relation("ResidenceCreatedByUser")
  createdDepartments            Department[]                 @relation("DepartmentCreatedByUser")
  assignedMembershipAccessRoles MembershipAccessRole[]       @relation("MembershipAccessRoleAssignedByUser")
  createdJobRequests            JobRequest[]                 @relation("JobRequestCreator")
  authoredJobRequests           JobRequest[]                 @relation("JobRequestCreatedByUser")
  updatedJobRequests            JobRequest[]                 @relation("JobRequestUpdatedByUser")
  ownedDispatchReviews          DispatchReview[]             @relation("DispatchReviewOwner")
  createdDispatchReviews        DispatchReview[]             @relation("DispatchReviewCreatedByUser")
  updatedDispatchReviews        DispatchReview[]             @relation("DispatchReviewUpdatedByUser")
  addedDispatchCandidates       DispatchCandidate[]          @relation("DispatchCandidateAddedByUser")
  removedDispatchCandidates     DispatchCandidate[]          @relation("DispatchCandidateRemovedByUser")
  workerIdentity                WorkerIdentity?
  createdWorkerOffers           WorkerOffer[]                @relation("WorkerOfferCreatedByUser")
  updatedWorkerOffers           WorkerOffer[]                @relation("WorkerOfferUpdatedByUser")
  approvedWorkerOffers          WorkerOffer[]                @relation("WorkerOfferApprovedByUser")
  sentWorkerOffers              WorkerOffer[]                @relation("WorkerOfferSentByUser")
  withdrawnWorkerOffers         WorkerOffer[]                @relation("WorkerOfferWithdrawnByUser")
  cancelledWorkerOffers         WorkerOffer[]                @relation("WorkerOfferCancelledByUser")
  createdWorkerOfferTerms       WorkerOfferTermsVersion[]    @relation("WorkerOfferTermsCreatedByUser")
  createdWorkerOfferDeliveries  WorkerOfferDeliveryAttempt[] @relation("WorkerOfferDeliveryCreatedByUser")
  createdAssignments            Assignment[]                 @relation("AssignmentCreatedByUser")
  updatedAssignments            Assignment[]                 @relation("AssignmentUpdatedByUser")
  confirmedAssignments          Assignment[]                 @relation("AssignmentConfirmedByUser")
  cancelledAssignments          Assignment[]                 @relation("AssignmentCancelledByUser")
  createdAttendanceRecords      AttendanceRecord[]           @relation("AttendanceCreatedByUser")
  updatedAttendanceRecords      AttendanceRecord[]           @relation("AttendanceUpdatedByUser")
  checkedInAttendanceRecords    AttendanceRecord[]           @relation("AttendanceCheckedInByUser")
  checkedOutAttendanceRecords   AttendanceRecord[]           @relation("AttendanceCheckedOutByUser")
  cancelledAttendanceRecords    AttendanceRecord[]           @relation("AttendanceCancelledByUser")
  createdTimesheets             Timesheet[]                  @relation("TimesheetCreatedByUser")
  updatedTimesheets             Timesheet[]                  @relation("TimesheetUpdatedByUser")
  workerReviewedTimesheets      Timesheet[]                  @relation("TimesheetWorkerReviewedByUser")
  employerReviewedTimesheets    Timesheet[]                  @relation("TimesheetEmployerReviewedByUser")
  platformReviewedTimesheets    Timesheet[]                  @relation("TimesheetPlatformReviewedByUser")
  lockedTimesheets              Timesheet[]                  @relation("TimesheetLockedByUser")
  auditActorReferences          AuditActorReference[]
  platformAccessGrants          PlatformAccessGrant[]
  completedAdminBootstraps      InitialAdminBootstrap[]      @relation("InitialAdminBootstrapCreatedUser")
  ownedUploadedDocuments        UploadedDocument[]           @relation("UploadedDocumentOwner")

  @@index([emailNormalized], map: "users_email_normalized_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserIdentity {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  provider          IdentityProvider
  providerSubject   String           @map("provider_subject")
  emailVerifiedAt   DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  passwordHash      String?          @map("password_hash")
  passwordUpdatedAt DateTime?        @map("password_updated_at") @db.Timestamptz(3)
  mfaState          MfaState         @default(not_configured) @map("mfa_state")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject], map: "user_identities_provider_subject_key")
  @@index([userId], map: "user_identities_user_id_idx")
  @@index([provider, providerSubject], map: "user_identities_provider_subject_idx")
  @@map("user_identities")
}

model Session {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  sessionHash   String        @unique @map("session_hash")
  status        SessionStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz(3)
  ipHash        String?       @map("ip_hash")
  userAgentHash String?       @map("user_agent_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionHash], map: "sessions_session_hash_idx")
  @@index([userId, status], map: "sessions_user_id_status_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model EmailVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, createdAt], map: "email_verification_codes_user_active_idx")
  @@index([expiresAt], map: "email_verification_codes_expires_at_idx")
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt, createdAt], map: "password_reset_tokens_user_active_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model EmployerOrganization {
  id               String                     @id @default(uuid()) @db.Uuid
  publicId         String                     @unique @map("public_id")
  legalName        String                     @map("legal_name")
  displayName      String                     @map("display_name")
  status           EmployerOrganizationStatus @default(pending_review)
  createdByUserId  String?                    @map("created_by_user_id") @db.Uuid
  reviewedByUserId String?                    @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  restrictedAt     DateTime?                  @map("restricted_at") @db.Timestamptz(3)
  suspendedAt      DateTime?                  @map("suspended_at") @db.Timestamptz(3)
  closedAt         DateTime?                  @map("closed_at") @db.Timestamptz(3)

  createdBy            User?                    @relation("EmployerOrganizationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy           User?                    @relation("EmployerOrganizationReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  memberships          OrganizationMembership[]
  residences           Residence[]
  departments          Department[]
  jobRequests          JobRequest[]
  dispatchReviews      DispatchReview[]
  workerOffers         WorkerOffer[]
  assignments          Assignment[]
  attendanceRecords    AttendanceRecord[]
  timesheets           Timesheet[]
  invoices             Invoice[]
  paymentMethods       EmployerPaymentMethod[]
  paymentAttempts      EmployerPaymentAttempt[]
  paymentPolicies      PaymentPolicyVersion[]
  contracts            EmployerContract[]       @relation("EmployerOrganizationContracts")
  uploadedDocuments    UploadedDocument[]
  auditActorReferences AuditActorReference[]
  requestCancellations EmployerRequestCancellation[]
  cancellationObligations EmployerCancellationObligation[]
  capacityReductions EmployerCapacityReduction[]
  changeProposals EmployerRequestChangeProposal[]
  workerInterests WorkerJobInterest[]
  verification EmployerVerification?

  orders EmployerOrder[]

  @@index([status], map: "employer_organizations_status_idx")
  @@map("employer_organizations")
}

// Governed employer<->platform contract. Holds the authoritative per-role hourly
// pay rate an active request reads from — the request never invents a price.
enum EmployerContractStatus {
  draft
  signed
  active
  superseded
}

model EmployerContract {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  version         String
  status          EmployerContractStatus @default(draft)
  currency        String
  signedByUserId  String?                @map("signed_by_user_id") @db.Uuid
  signedAt        DateTime?              @map("signed_at") @db.Timestamptz(3)
  activatedAt     DateTime?              @map("activated_at") @db.Timestamptz(3)
  effectiveFrom   DateTime?              @map("effective_from") @db.Timestamptz(3)
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization EmployerOrganization @relation("EmployerOrganizationContracts", fields: [organizationId], references: [id], onDelete: Restrict)
  roleRates    ContractRoleRate[]

  @@unique([organizationId, version], map: "employer_contracts_organization_version_key")
  @@index([organizationId, status], map: "employer_contracts_organization_status_idx")
  @@map("employer_contracts")
}

model ContractRoleRate {
  id               String   @id @default(uuid()) @db.Uuid
  contractId       String   @map("contract_id") @db.Uuid
  workGroupId      String   @map("work_group_id") @db.Uuid
  roleDefinitionId String   @map("role_definition_id") @db.Uuid
  hourlyRateMinor  Int      @map("hourly_rate_minor")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contract EmployerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, roleDefinitionId], map: "contract_role_rates_contract_role_key")
  @@map("contract_role_rates")
}

enum EmployerCancellationCause {
  EMPLOYER_CANCELLED
  WORKER_CANCELLED
  WORKER_NO_SHOW
  PLATFORM_UNABLE_TO_FILL
  PLATFORM_CANCELLED
  MUTUALLY_CANCELLED
}

enum EmployerRequestCancellationStatus {
  requested
  assignment_cancellation_pending
  completed
  failed
  requires_reconciliation
}

enum EmployerCancellationObligationStatus {
  RECORDED
  VOIDED
  ADJUSTED
}

// Governed two-step employer cancellation (Option A) — the employer-facing
// lifecycle record. Confirmed-assignment state stays platform-governed; this
// record tracks the intent + the platform handoff outcome. One per job request.
model EmployerRequestCancellation {
  id                       String                            @id @default(uuid()) @db.Uuid
  organizationId           String                            @map("organization_id") @db.Uuid
  jobRequestId             String                            @unique @map("job_request_id") @db.Uuid
  cause                    EmployerCancellationCause
  status                   EmployerRequestCancellationStatus @default(requested)
  affectedConfirmedWorkers Int                               @map("affected_confirmed_workers")
  idempotencyKey           String                            @unique @map("idempotency_key")
  initiatedByUserId        String                            @map("initiated_by_user_id") @db.Uuid
  initiatedAt              DateTime                          @default(now()) @map("initiated_at") @db.Timestamptz(3)
  handoffAttempts          Int                               @default(0) @map("handoff_attempts")
  lastHandoffAt            DateTime?                         @map("last_handoff_at") @db.Timestamptz(3)
  reconciliationNote       String?                           @map("reconciliation_note")
  version                  Int                               @default(1)
  createdAt                DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization EmployerOrganization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRequest   JobRequest                      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  obligation   EmployerCancellationObligation?

  @@index([organizationId, status], map: "employer_request_cancellations_org_status_idx")
  @@map("employer_request_cancellations")
}

// The employer <-> JobLop COMMERCIAL cancellation obligation — an auditable
// financial-intent snapshot. NEVER a payment; there is no PAID state. Immutable
// inputs snapshot (rate, rule hours, contract version) so it reproduces later.
model EmployerCancellationObligation {
  id                   String                               @id @default(uuid()) @db.Uuid
  cancellationId       String                               @unique @map("cancellation_id") @db.Uuid
  organizationId       String                               @map("organization_id") @db.Uuid
  jobRequestId         String                               @map("job_request_id") @db.Uuid
  cause                EmployerCancellationCause
  confirmedWorkerCount Int                                  @map("confirmed_worker_count")
  governedRateMinor    Int                                  @map("governed_rate_minor")
  currency             String
  minimumShiftHours    Int                                  @map("minimum_shift_hours")
  cutoffHours          Int                                  @map("cutoff_hours")
  contractId           String?                              @map("contract_id") @db.Uuid
  contractVersion      String?                              @map("contract_version")
  amountMinor          Int                                  @map("amount_minor")
  status               EmployerCancellationObligationStatus @default(RECORDED)
  computedByUserId     String                               @map("computed_by_user_id") @db.Uuid
  computedAt           DateTime                             @default(now()) @map("computed_at") @db.Timestamptz(3)
  createdAt            DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)

  cancellation EmployerRequestCancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
  organization EmployerOrganization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRequest   JobRequest                 @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, status], map: "employer_cancellation_obligations_org_status_idx")
  @@map("employer_cancellation_obligations")
}

enum EmployerCapacityReductionStatus {
  requested
  assignment_cancellation_pending
  completed
  requires_reconciliation
  failed
}

// Employer Reduce Workers — a governed capacity reduction with PARTIAL cancellation.
// NOT whole-request Cancel: the request stays active at the new target. Multiple
// reductions may occur over a request's lifetime, so this is NOT unique per request
// (idempotency is by idempotency_key). Holds an embedded commercial-obligation
// snapshot for the affected confirmed assignments (never PAID; no worker-facing money).
model EmployerCapacityReduction {
  id                       String                          @id @default(uuid()) @db.Uuid
  organizationId           String                          @map("organization_id") @db.Uuid
  jobRequestId             String                          @map("job_request_id") @db.Uuid
  initiatedByUserId        String                          @map("initiated_by_user_id") @db.Uuid
  cause                    EmployerCancellationCause       @default(EMPLOYER_CANCELLED)
  status                   EmployerCapacityReductionStatus @default(requested)
  previousTarget           Int                             @map("previous_target")
  newTarget                Int                             @map("new_target")
  removedUnfilledCapacity  Int                             @map("removed_unfilled_capacity")
  affectedConfirmedCount   Int                             @map("affected_confirmed_count")
  selectedAssignmentIds    Json                            @map("selected_assignment_ids")
  expectedRequestVersion   Int                             @map("expected_request_version")
  obligationAmountMinor    Int?                            @map("obligation_amount_minor")
  governedRateMinor        Int?                            @map("governed_rate_minor")
  currency                 String
  minimumShiftHours        Int?                            @map("minimum_shift_hours")
  cutoffHours              Int?                            @map("cutoff_hours")
  contractId               String?                         @map("contract_id") @db.Uuid
  contractVersion          String?                         @map("contract_version")
  idempotencyKey           String                          @unique @map("idempotency_key")
  handoffAttempts          Int                             @default(0) @map("handoff_attempts")
  lastHandoffAt            DateTime?                        @map("last_handoff_at") @db.Timestamptz(3)
  reconciliationNote       String?                         @map("reconciliation_note")
  version                  Int                             @default(1)
  createdAt                DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobRequest   JobRequest           @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, status], map: "employer_capacity_reductions_org_status_idx")
  @@index([jobRequestId], map: "employer_capacity_reductions_job_request_id_idx")
  @@map("employer_capacity_reductions")
}

enum EmployerRequestChangeProposalStatus {
  proposed
  reconfirmation_pending
  completed
  rejected
  requires_reconciliation
  cancelled
}

// Employer Material Edit — a governed change proposal. A MATERIAL live edit must NOT
// overwrite accepted worker terms: it is recorded here (proposed → reconfirmation),
// the original accepted terms are preserved, and the request revision finalizes only
// after the governed reconfirmation completes. Non-material edits are applied directly
// and are NOT recorded here.
model EmployerRequestChangeProposal {
  id                    String                              @id @default(uuid()) @db.Uuid
  organizationId        String                              @map("organization_id") @db.Uuid
