  // Provenance: which governed contract version + source shift produced this earning (null for
  // derived earnings like vacation-pay accrual that are computed on the segment total).
  sourceContractId    String?            @map("source_contract_id") @db.Uuid
  sourceContractVersion String?          @map("source_contract_version")
  sortOrder           Int                @default(0) @map("sort_order")

  payrollCalculation  PayrollCalculation @relation(fields: [payrollCalculationId], references: [id], onDelete: Cascade)

  @@index([payrollCalculationId], map: "payroll_earning_lines_calculation_idx")
