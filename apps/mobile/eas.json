{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_RWOS_DEPLOYMENT_TIER": "staging",
        "EXPO_PUBLIC_RWOS_API_ORIGIN": "https://joblop-api.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_RWOS_DEPLOYMENT_TIER": "production",
        "EXPO_PUBLIC_RWOS_API_ORIGIN": "https://joblop-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
