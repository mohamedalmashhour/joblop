{
  "name": "@rwos/api",
  "version": "0.1.0-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "e2e:bootstrap-passwords": "node --import tsx src/stagingE2eSyntheticPasswordBootstrap.ts",
    "jobscanner:seed": "node --import tsx src/seedJobScannerLeads.ts",
    "lint": "eslint .",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rwos/auth": "workspace:*",
    "@rwos/config": "workspace:*",
    "@rwos/country-syria": "workspace:*",
    "@rwos/database": "workspace:*",
    "@rwos/observability": "workspace:*",
    "@rwos/service-auth": "workspace:*",
    "@rwos/shared": "workspace:*",
    "fastify": "^5.12.7",
    "stripe": "^22.4.0"
  }
}
